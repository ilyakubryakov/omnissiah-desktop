#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

runtime = Path(os.environ['XDG_RUNTIME_DIR']) / 'omnissiah-recording'
runtime.mkdir(mode=0o700, exist_ok=True)
state = runtime / 'pid'

def output(*args):
    return subprocess.check_output(args, text=True).strip()

def encoding():
    encoders = {row.split()[1] for row in output('ffmpeg', '-hide_banner', '-encoders').splitlines() if len(row.split()) > 1}
    if 'libx264' in encoders and 'aac' in encoders:
        return 'mp4', ['-c', 'libx264', '-p', 'preset=veryfast', '-C', 'aac']
    if 'libvpx-vp9' in encoders and 'libopus' in encoders:
        return 'webm', ['-c', 'libvpx-vp9', '-p', 'deadline=realtime', '-p', 'cpu-used=6', '-C', 'libopus']
    raise RuntimeError('No supported recording encoder found. Install FFmpeg with H.264/AAC or VP9/Opus support.')

def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else 'screen'
    modules = []
    with (runtime / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            pid = int(state.read_text())
            command = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
            if any(Path(os.fsdecode(arg)).name == 'station-record' for arg in command if arg):
                os.kill(pid, signal.SIGINT)
                return 0
        except (OSError, ValueError):
            pass
        state.unlink(missing_ok=True)
        if mode == 'stop':
            return 1
        state.write_text(str(os.getpid()))
    child = None
    interrupted = False
    def stop(signum, frame):
        nonlocal interrupted
        interrupted = True
        if child and child.poll() is None:
            child.send_signal(signal.SIGINT)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        prefs = {'audio': 'yes', 'mic': 'no', 'pointer': 'no'}
        config = Path.home() / '.local/state/station/capture.conf'
        if config.exists():
            prefs.update(line.split('=', 1) for line in config.read_text().splitlines() if '=' in line)
        target = Path.home() / 'Videos/Screencasts'
        target.mkdir(parents=True, exist_ok=True)
        extension, codec = encoding()
        path = target / (time.strftime('Screencast %Y-%m-%d %H.%M.%S.') + extension)
        args = ['wf-recorder', '-f', str(path), *codec, '-x', 'yuv420p', '-r', '30']
        if prefs['pointer'] != 'yes':
            args.append('--no-cursor')
        if mode == 'region':
            args += ['-g', output('slurp')]
        else:
            monitors = json.loads(output('hyprctl', 'monitors', '-j'))
            args += ['-o', next(m['name'] for m in monitors if m['focused'])]
        sources = []
        if prefs['audio'] == 'yes':
            sources.append(output('pactl', 'get-default-sink') + '.monitor')
        if prefs['mic'] == 'yes':
            sources.append(output('pactl', 'get-default-source'))
        if len(sources) == 2:
            sink = 'omnissiah_record_' + str(os.getpid())
            modules.append(output('pactl', 'load-module', 'module-null-sink', 'sink_name=' + sink))
            for source in sources:
                modules.append(output('pactl', 'load-module', 'module-loopback', 'source=' + source, 'sink=' + sink))
            sources = [sink + '.monitor']
        if sources:
            args.append('--audio=' + sources[0])
        if interrupted:
            return 0
        subprocess.run(['notify-send', '-a', 'Screencast', 'Recording', 'Press the capture key again to stop'], check=False)
        child = subprocess.Popen(args)
        result = child.wait()
        if path.exists() and path.stat().st_size > 1024 and result in (0, -signal.SIGINT, 130):
            subprocess.run(['notify-send', '-a', 'Screencast', 'Recording saved', str(path)], check=False)
        elif not interrupted:
            raise RuntimeError('The recorder failed. Check the session journal.')
        return 0
    finally:
        for module in reversed(modules):
            subprocess.run(['pactl', 'unload-module', module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        state.unlink(missing_ok=True)

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError, StopIteration) as error:
        subprocess.run(['notify-send', '-a', 'Screencast', 'Recording failed', str(error)], check=False)
        sys.exit(1)
