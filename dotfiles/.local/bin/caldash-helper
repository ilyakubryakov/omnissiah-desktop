#!/usr/bin/env python3

import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import station_calendar as accounts

import icalendar
import recurring_ical_events
from dateutil.easter import easter

from omnissiah_config import integrations
local_zone = Path('/etc/localtime').resolve()
LOCAL_TZ = ZoneInfo(str(local_zone).split('/zoneinfo/')[-1]) if '/zoneinfo/' in str(local_zone) else datetime.now().astimezone().tzinfo
CLOCKS = integrations().get('clocks', {})

MAX_DOTS = 3
FETCH_TIMEOUT = 20

def nth_weekday(year, month, weekday, n):

    if n > 0:
        d = date(year, month, 1)
        d += timedelta(days=(weekday - d.weekday()) % 7)
        return d + timedelta(weeks=n - 1)
    nxt = date(year + (month == 12), month % 12 + 1, 1)
    d = nxt - timedelta(days=1)
    return d - timedelta(days=(d.weekday() - weekday) % 7)

def holidays_lt(year):
    e = easter(year)
    return {
        date(year, 1, 1): "Naujieji metai",
        date(year, 2, 16): "Valstybes atkurimo diena",
        date(year, 3, 11): "Nepriklausomybes atkurimo diena",
        e: "Velykos",
        e + timedelta(days=1): "Velyku antroji diena",
        date(year, 5, 1): "Darbo diena",
        nth_weekday(year, 5, 6, 1): "Motinos diena",
        nth_weekday(year, 6, 6, 1): "Tevo diena",
        date(year, 6, 24): "Jonines",
        date(year, 7, 6): "Valstybes diena",
        date(year, 8, 15): "Zoline",
        date(year, 11, 1): "Visu sventuju diena",
        date(year, 11, 2): "Velines",
        date(year, 12, 24): "Kucios",
        date(year, 12, 25): "Kaledos",
        date(year, 12, 26): "Kaledos (antroji diena)",
    }

def holidays_ie(year):
    e = easter(year)
    feb1 = date(year, 2, 1)

    brigid = feb1 if feb1.weekday() == 4 else nth_weekday(year, 2, 0, 1)
    h = {
        date(year, 1, 1): "New Year's Day",
        brigid: "St Brigid's Day",
        date(year, 3, 17): "St Patrick's Day",
        e + timedelta(days=1): "Easter Monday",
        nth_weekday(year, 5, 0, 1): "May Bank Holiday",
        nth_weekday(year, 6, 0, 1): "June Bank Holiday",
        nth_weekday(year, 8, 0, 1): "August Bank Holiday",
        nth_weekday(year, 10, 0, -1): "October Bank Holiday",
        date(year, 12, 25): "Christmas Day",
        date(year, 12, 26): "St Stephen's Day",
    }

    for d in (date(year, 1, 1), date(year, 3, 17), date(year, 12, 25), date(year, 12, 26)):
        if d.weekday() < 5:
            continue
        sub = d
        while sub.weekday() >= 5 or sub in h:
            sub += timedelta(days=1)
        h[sub] = h[d] + " (observed)"
    return h

def holiday_map(years):
    out = {}
    for y in years:
        for country, table in (("lt", holidays_lt(y)), ("ie", holidays_ie(y))):
            if country not in integrations().get("holidays", []): continue
            for d, name in table.items():
                out.setdefault(d, []).append({"c": country, "n": name})
    return out

def local(dt):

    if not isinstance(dt, datetime):
        return datetime(dt.year, dt.month, dt.day, tzinfo=LOCAL_TZ)
    return (dt.replace(tzinfo=LOCAL_TZ) if dt.tzinfo is None else dt).astimezone(LOCAL_TZ)

class HttpsRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme != "https":
            raise accounts.CalendarError("feed", "The calendar feed redirected to an insecure address.")
        return super().redirect_request(req, fp, code, msg, headers, newurl)

def source_ics(key, url, start, end):

    if urllib.parse.urlsplit(url).scheme != "https":
        raise accounts.CalendarError("feed", "The calendar feed must use HTTPS.")
    req = urllib.request.Request(url, headers={"User-Agent": "caldash/1"})
    with urllib.request.build_opener(HttpsRedirect).open(req, timeout=FETCH_TIMEOUT) as r:
        body = r.read(8 * 1024 * 1024 + 1)
        if len(body) > 8 * 1024 * 1024:
            raise accounts.CalendarError("feed", "The calendar feed exceeds the 8 MiB limit.")
        text = body.decode("utf-8", "replace")
    if "BEGIN:VCALENDAR" not in text:
        raise ValueError("not an iCalendar document")

    out = []
    cal = icalendar.Calendar.from_ical(text)
    for ev in recurring_ical_events.of(cal).between(start, end):
        dtstart = ev.get("DTSTART")
        if dtstart is None:
            continue
        raw = dtstart.dt
        allday = not isinstance(raw, datetime)
        s = local(raw)
        dtend = ev.get("DTEND")
        e = local(dtend.dt) if dtend is not None else s
        out.append({
            "s": s.isoformat(),
            "e": e.isoformat(),
            "t": str(ev.get("SUMMARY", "(no title)"))[:80],
            "c": key,
            "a": allday,
        })
    return out

def collect_events(start, end):
    events, status = accounts.collect_sources(start, end, LOCAL_TZ, source_ics)

    active = {a["id"] + ":" + c["id"] for a in accounts.load_accounts()["accounts"]
              if a.get("enabled", True) for c in a["calendars"] if c["selected"]}
    events = [e for e in events if e["c"] in active]
    status = {key: value for key, value in status.items() if key in active}
    days = {}
    for ev in events:
        s = datetime.fromisoformat(ev["s"])
        e = datetime.fromisoformat(ev["e"])

        last = (e - timedelta(microseconds=1)).date() if e > s else s.date()
        d = s.date()
        while d <= last and (d - s.date()).days < 60:
            dots = days.setdefault(d.isoformat(), {}).setdefault("e", [])
            if len(dots) < MAX_DOTS:
                dots.append(ev["c"])
            d += timedelta(days=1)

    events.sort(key=lambda x: datetime.fromisoformat(x["s"]).timestamp())
    return days, events, status

def main():
    if "--auth" in sys.argv:
        import webbrowser
        key = sys.argv[sys.argv.index("--auth") + 1] if sys.argv.index("--auth") + 1 < len(sys.argv) else "work"
        item = next((a for a in accounts.load_accounts()["accounts"] if a.get("legacy_key") == key or a["id"] == key), None)
        if item is None:
            sys.exit("Use Control Station > Calendars to add an account first.")
        accounts.authorize({"id": item["id"]}, lambda msg: webbrowser.open(msg["url"]))
        return

    now = datetime.now(LOCAL_TZ)
    today = now.date()

    start = date(today.year, today.month, 1) - timedelta(days=1)
    start = date(start.year, start.month, 1)
    end = date(today.year, today.month, 1)
    for _ in range(3):
        end = date(end.year + (end.month == 12), end.month % 12 + 1, 1)
    end += timedelta(days=7)

    configured = bool(accounts.load_accounts()["accounts"])
    days, events, status = collect_events(
        datetime.combine(start, datetime.min.time(), LOCAL_TZ),
        datetime.combine(end, datetime.min.time(), LOCAL_TZ),
    )

    for d, entries in holiday_map(range(start.year, end.year + 1)).items():
        if start <= d <= end:
            days.setdefault(d.isoformat(), {})["h"] = entries

    next_holiday = None
    for d in sorted(days):
        if d >= today.isoformat() and days[d].get("h"):
            entry = days[d]["h"][0]
            next_holiday = {"d": d, "c": entry["c"], "n": entry["n"]}
            break

    out = {
        "ts": time.time(),
        "today": today.isoformat(),
        "days": days,
        "events": events,
        "next_holiday": next_holiday,
        "clocks": {
            k: int(now.astimezone(ZoneInfo(tz)).utcoffset().total_seconds())
            for k, tz in CLOCKS.items()
        },
        "cals": status,
        "configured": configured,
    }

    accounts.publish(out)

    if "--verbose" in sys.argv:
        print(f"{len(days)} days, {len(events)} events, calendars: {status or 'none configured'}")

if __name__ == "__main__":
    os.umask(0o077)
    try:
        with accounts.lock("sync", blocking=False):
            if "--auth" in sys.argv:
                main()
            else:
                accounts.load_accounts()

                for _ in range(4):
                    generation = accounts.ACCOUNTS.stat().st_mtime_ns
                    main()
                    if accounts.ACCOUNTS.stat().st_mtime_ns == generation:
                        break
    except BlockingIOError:
        pass
    except Exception as exc:
        print(accounts.safe_error(exc)["message"], file=sys.stderr)
        sys.exit(1)
