#!/usr/bin/env python3

import csv
import io
import math
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

def number(path, divisor=1):
    try:
        return float(Path(path).read_text().strip()) / divisor
    except (OSError, ValueError):
        return None

def ratio(used, total):
    return 100 * used / total if used is not None and total else None

def amd_status(root=Path('/sys/class/drm'), pci=None):
    devices = []
    for card in root.glob('card[0-9]*'):
        if not re.fullmatch(r'card\d+', card.name):
            continue
        device = card / 'device'
        try:
            if (device / 'vendor').read_text().strip() != '0x1002':
                continue
        except OSError:
            continue
        devices.append((number(device / 'mem_info_vram_total') or 0, device))
    candidates = [d for _, d in sorted(devices, key=lambda pair: pair[0], reverse=True)]
    device = next((d for d in candidates if not pci or d.resolve().name == pci), None)
    if device is None:
        return {'available': False}
    hwmon = next(iter((device / 'hwmon').glob('hwmon*')), None)
    def read(name, divisor=1):
        return number(hwmon / name, divisor) if hwmon else None
    total = number(device / 'mem_info_vram_total')
    used = number(device / 'mem_info_vram_used')
    return {'available': True, 'pci': device.resolve().name,
            'load': number(device / 'gpu_busy_percent'), 'temp': read('temp1_input', 1000),
            'hotspot': read('temp2_input', 1000), 'memoryTemp': read('temp3_input', 1000),
            'powerW': read('power1_average', 1000000), 'powerCapW': read('power1_cap', 1000000),
            'vramUsed': used, 'vramTotal': total, 'vramPct': ratio(used, total)}

def nvidia_status(pci=None):
    fields = ['uuid', 'pci.bus_id', 'name', 'memory.total', 'memory.used',
              'utilization.gpu', 'temperature.gpu', 'power.draw', 'power.limit']
    def numeric(value):
        try:
            n = float(value)
            return n if math.isfinite(n) and n >= 0 else None
        except (ValueError, TypeError):
            return None
    def bus(value):
        match = re.fullmatch(r'([0-9a-fA-F]{4,8}):([0-9a-fA-F]{2}):([0-9a-fA-F]{2}\.[0-7])', value)
        if not match:
            return None
        return f'{int(match[1], 16):04x}:{match[2].lower()}:{match[3].lower()}'
    if pci and bus(pci) is None:
        return {'available': False}
    try:
        result = subprocess.run(['nvidia-smi', '--query-gpu=' + ','.join(fields),
                                 '--format=csv,noheader,nounits'],
                                capture_output=True, text=True, timeout=2, check=True)
    except (OSError, subprocess.SubprocessError):
        return {'available': False}
    cards = []
    for row in csv.reader(io.StringIO(result.stdout), skipinitialspace=True):
        if len(row) != len(fields):
            continue
        row = [value.strip() for value in row]
        address = bus(row[1])
        if address is None or (pci and address != bus(pci)):
            continue
        total, used, load, temp, watts, cap = map(numeric, row[3:])
        cards.append({'available': True, 'vendor': 'nvidia', 'uuid': row[0],
                      'pci': address, 'name': row[2], 'load': load, 'temp': temp,
                      'hotspot': None, 'memoryTemp': None, 'powerW': watts, 'powerCapW': cap,
                      'vramTotal': total * 1024**2 if total is not None else None,
                      'vramUsed': used * 1024**2 if used is not None else None,
                      'vramPct': ratio(used, total)})
    return max(cards, key=lambda c: c['vramTotal'] or 0) if cards else {'available': False}

def gpu_status(root=Path('/sys/class/drm'), pci=None):

    if os.environ.get('STATION_GPU_VENDOR') == 'nvidia':
        return nvidia_status(pci)
    return amd_status(root, pci)

class Local:
    def __init__(self):
        self.previous_cpu = None
        self.previous_disks = {}
        self.previous_time = None

    def collect(self):
        fields = list(map(int, Path('/proc/stat').read_text().splitlines()[0].split()[1:9]))
        total, idle = sum(fields), fields[3] + fields[4]
        cpu = None
        if self.previous_cpu:
            pt, pi = self.previous_cpu
            cpu = ratio((total - pt) - (idle - pi), total - pt)
        self.previous_cpu = total, idle
        mem = {k: int(v.split()[0]) for k, v in (line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())}
        temp = None
        for hwmon in Path('/sys/class/hwmon').glob('hwmon*'):
            try:
                if (hwmon / 'name').read_text().strip() in {'k10temp', 'coretemp', 'cpu_thermal'}:
                    temp = number(hwmon / 'temp1_input', 1000)
                    break
            except OSError:
                continue
        ticks = {f[2]: int(f[12]) for f in (line.split() for line in Path('/proc/diskstats').read_text().splitlines())
                 if len(f) > 12 and re.fullmatch(r'(nvme\d+n\d+|sd[a-z]+|vd[a-z]+)', f[2])}
        now = time.monotonic()
        busy = []
        if self.previous_time is not None:
            elapsed = (now - self.previous_time) * 1000
            busy = [max(0, min(100, 100 * (ticks[k] - self.previous_disks[k]) / elapsed))
                    for k in ticks if k in self.previous_disks]
        self.previous_time, self.previous_disks = now, ticks
        disks = []
        for name, path in [('System', '/'), ('Home', '/home')]:
            if not os.path.ismount(path):
                continue
            usage = shutil.disk_usage(path)
            disks.append({'name': name, 'pct': ratio(usage.used, usage.total),
                          'usedTb': usage.used / 10**12, 'totalTb': usage.total / 10**12})
        return {'cpuLoad': cpu, 'cpuTemp': temp,
                'ramPct': ratio(mem['MemTotal'] - mem['MemAvailable'], mem['MemTotal']),
                'ramUsedGb': (mem['MemTotal'] - mem['MemAvailable']) / 1024**2,
                'ramTotalGb': mem['MemTotal'] / 1024**2,
                'swapPct': ratio(mem['SwapTotal'] - mem['SwapFree'], mem['SwapTotal']) if mem['SwapTotal'] else 0,
                'loadPct': 100 * os.getloadavg()[0] / (os.cpu_count() or 1),
                'diskIo': max(busy) if busy else None, 'disks': disks,
                'gpu': gpu_status(pci=os.environ.get('STATION_GPU_PCI'))}

def safe(fn):
    try:
        return fn()
    except Exception:
        return {'available': False}

def main():
    once = '--once' in sys.argv
    out = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'station-status.json'
    local = Local()
    os.umask(0o077)
    out.parent.mkdir(parents=True, exist_ok=True)
    while True:
        started = time.monotonic()
        data = {'local': safe(local.collect), 'ts': time.time()}
        temporary = out.with_suffix('.tmp')
        temporary.write_text(json.dumps(data, allow_nan=False))
        temporary.replace(out)
        if once:
            break
        time.sleep(max(0.1, 5 - (time.monotonic() - started)))

if __name__ == '__main__':
    main()
