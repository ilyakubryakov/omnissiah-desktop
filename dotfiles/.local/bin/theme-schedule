#!/usr/bin/env python3

import datetime as dt
import json
import math
import os
import re
import tomllib
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "theme-schedule.conf"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "theme"
CURRENT = STATE_DIR / "name"
OVERRIDE = STATE_DIR / "override"
NIGHTLIGHT = STATE_DIR / "nightlight"
NIGHT_KELVIN = 4000

NIGHT_SETTINGS = STATE_DIR / "nightlight.json"

THEMES = Path(__file__).resolve().parents[3] / "themes"
LIGHT = "kanagawa-lotus"
DARK = "omnissiah"

DEFAULTS = {
    "mode": "manual",
    "light_palette": LIGHT,
    "dark_palette": DARK,
    "light_at": "07:30",
    "dark_at": "19:30",
    "lat": "0",
    "lon": "0",
    "offset_min": "0",
}

def palette_mode(name):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        return None
    try:
        return tomllib.loads((THEMES / name / "colors.toml").read_text())["mode"]
    except (OSError, ValueError, KeyError):
        return None

def load():
    cfg = dict(DEFAULTS)
    if CONFIG.is_file():
        for line in CONFIG.read_text(errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            cfg[k.strip()] = v.strip()
    for variant in ("light", "dark"):
        key = f"{variant}_palette"
        if palette_mode(cfg[key]) != variant:
            cfg[key] = DEFAULTS[key]
    return cfg

def save(cfg):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join(f"{k}={v}" for k, v in sorted(cfg.items()))
    CONFIG.write_text("# Written by theme-schedule / the panel applet.\n" + body + "\n")

def parse_hm(text, fallback):
    try:
        h, m = text.split(":")
        return dt.time(int(h), int(m))
    except (ValueError, AttributeError):
        return fallback

def sun_times(day, lat, lon):

    n = day.toordinal() - dt.date(2000, 1, 1).toordinal() + 0.0008
    j_star = n - lon / 360.0
    m = math.radians((357.5291 + 0.98560028 * j_star) % 360)
    c = 1.9148 * math.sin(m) + 0.0200 * math.sin(2 * m) + 0.0003 * math.sin(3 * m)
    lam = math.radians((math.degrees(m) + c + 180 + 102.9372) % 360)
    j_transit = 2451545.0 + j_star + 0.0053 * math.sin(m) - 0.0069 * math.sin(2 * lam)
    decl = math.asin(math.sin(lam) * math.sin(math.radians(23.4397)))

    phi = math.radians(lat)

    cos_w = (math.sin(math.radians(-0.833)) - math.sin(phi) * math.sin(decl)) / (
        math.cos(phi) * math.cos(decl)
    )
    if cos_w > 1 or cos_w < -1:
        return None, None
    w = math.degrees(math.acos(cos_w))

    j_set = j_transit + w / 360.0
    j_rise = j_transit - w / 360.0

    def to_local(julian):
        stamp = (julian - 2440587.5) * 86400.0
        return dt.datetime.fromtimestamp(stamp).astimezone()

    return to_local(j_rise), to_local(j_set)

def boundaries(cfg, now):

    mode = cfg["mode"]
    if mode == "fixed":
        light = dt.datetime.combine(now.date(), parse_hm(cfg["light_at"], dt.time(7, 30))).astimezone()
        dark = dt.datetime.combine(now.date(), parse_hm(cfg["dark_at"], dt.time(19, 30))).astimezone()
        return light, dark
    if mode == "sun":
        try:
            rise, set_ = sun_times(now.date(), float(cfg["lat"]), float(cfg["lon"]))
        except ValueError:
            return None, None
        if rise is None:
            return None, None
        shift = dt.timedelta(minutes=int(cfg.get("offset_min", 0) or 0))
        return rise + shift, set_ + shift
    return None, None

def scheduled_variant(cfg, now):
    light, dark = boundaries(cfg, now)
    if light is None:
        return None
    return cfg["light_palette"] if light <= now < dark else cfg["dark_palette"]

def next_transition(cfg, now):
    light, dark = boundaries(cfg, now)
    if light is None:
        return None
    upcoming = sorted(t for t in (light, dark) if t > now)
    if upcoming:
        return upcoming[0]

    tomorrow = boundaries(cfg, now + dt.timedelta(days=1))
    return min(t for t in tomorrow if t) if tomorrow[0] else None

def current_variant():
    try:
        return CURRENT.read_text().strip()
    except OSError:
        return ""

def read_override(cfg, now):

    try:
        until = dt.datetime.fromisoformat(OVERRIDE.read_text().strip())
    except (OSError, ValueError):
        return None
    if until <= now:
        OVERRIDE.unlink(missing_ok=True)
        return None
    return until

def set_override(cfg, now):
    nxt = next_transition(cfg, now)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if nxt:
        OVERRIDE.write_text(nxt.isoformat())
    else:
        OVERRIDE.unlink(missing_ok=True)

def apply(variant):
    if variant == current_variant():
        return False
    subprocess.run([str(HOME / ".local/bin/theme"), "set", variant], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

def nightlight(cfg, now):

    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    try:
        settings = json.loads(NIGHT_SETTINGS.read_text())
    except (OSError, ValueError):
        settings = {}
    kelvin = settings.get("kelvin")
    kelvin = min(6000, max(2500, kelvin)) if isinstance(kelvin, int) else NIGHT_KELVIN
    start, end = parse_hm(settings.get("from"), None), parse_hm(settings.get("to"), None)
    night = False
    if NIGHTLIGHT.exists() and start and end:
        t = now.time()
        night = start <= t < end if start < end else (t >= start or t < end)
    elif NIGHTLIGHT.exists():
        try:
            rise, set_ = sun_times(now.date(), float(cfg["lat"]), float(cfg["lon"]))
            night = rise is not None and not (rise <= now < set_)
        except ValueError:
            pass
    if subprocess.run(["pgrep", "-x", "hyprsunset"], stdout=subprocess.DEVNULL).returncode != 0:
        if not night:
            return
        subprocess.Popen(["uwsm", "app", "--", "hyprsunset"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)

        for _ in range(20):
            if subprocess.run(["hyprctl", "hyprsunset", "identity"], capture_output=True).returncode == 0:
                break
            __import__("time").sleep(0.25)
    cmd = ["temperature", str(kelvin)] if night else ["identity"]
    subprocess.run(["hyprctl", "hyprsunset", *cmd], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def status(cfg, now):
    cur = current_variant()
    nxt = next_transition(cfg, now)
    override = read_override(cfg, now)
    return {
        "current": palette_mode(cur) or cur,
        "light_palette": cfg["light_palette"],
        "dark_palette": cfg["dark_palette"],
        "palette": cur,
        "mode": cfg["mode"],
        "light_at": cfg["light_at"],
        "dark_at": cfg["dark_at"],
        "offset_min": int(cfg.get("offset_min", 0) or 0),
        "scheduled": {cfg["light_palette"]: "light", cfg["dark_palette"]: "dark"}.get(scheduled_variant(cfg, now)),
        "next": nxt.isoformat() if nxt else None,
        "next_human": nxt.strftime("%H:%M") if nxt else None,
        "override_until": override.isoformat() if override else None,
        "nightlight": NIGHTLIGHT.exists(),
    }

def main():
    cfg = load()
    now = dt.datetime.now().astimezone()
    args = sys.argv[1:]

    if args and args[0] == "--status":
        print(json.dumps(status(cfg, now), indent=1))
        return

    if args and args[0] == "--nightlight":
        arg = args[1] if len(args) > 1 else "toggle"
        on = {"on": True, "off": False}.get(arg, not NIGHTLIGHT.exists())
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        NIGHTLIGHT.touch() if on else NIGHTLIGHT.unlink(missing_ok=True)
        nightlight(cfg, now)
        print(f"nightlight {'on' if on else 'off'}")
        return

    if args and args[0] == "--set":
        if len(args) < 2 or args[1] not in ("manual", "fixed", "sun"):
            sys.exit("usage: theme-schedule --set manual|fixed|sun")
        cfg["mode"] = args[1]
        save(cfg)
        OVERRIDE.unlink(missing_ok=True)
        want = scheduled_variant(cfg, now)
        if want:
            apply(want)
        print(f"mode {cfg['mode']}")
        return

    if args and args[0] == "--palette":
        if len(args) != 3 or args[1] not in ("light", "dark") or palette_mode(args[2]) != args[1]:
            sys.exit("Choose an existing palette with the matching light/dark mode")
        cfg[f"{args[1]}_palette"] = args[2]
        save(cfg)
        OVERRIDE.unlink(missing_ok=True)
        want = scheduled_variant(cfg, now)
        if want:
            apply(want)
        print(f"{args[1]}_palette {args[2]}")
        return

    if args and args[0] == "--time":
        if len(args) < 3 or args[1] not in ("light", "dark"):
            sys.exit("usage: theme-schedule --time light|dark HH:MM")
        if parse_hm(args[2], None) is None:
            sys.exit(f"not a time: {args[2]}")
        cfg[f"{args[1]}_at"] = args[2]
        save(cfg)
        OVERRIDE.unlink(missing_ok=True)
        want = scheduled_variant(cfg, now)
        if want:
            apply(want)
        print(f"{args[1]}_at {args[2]}")
        return

    if args and args[0] == "--offset":
        try:
            cfg["offset_min"] = str(int(args[1]))
        except (IndexError, ValueError):
            sys.exit("usage: theme-schedule --offset MINUTES")
        save(cfg)
        OVERRIDE.unlink(missing_ok=True)
        want = scheduled_variant(cfg, now)
        if want:
            apply(want)
        print(f"offset {cfg['offset_min']} min")
        return

    if args and args[0] in ("--light", "--dark", "--toggle"):
        if args[0] == "--toggle":
            want = cfg["dark_palette"] if palette_mode(current_variant()) == "light" else cfg["light_palette"]
        else:
            want = cfg["light_palette"] if args[0] == "--light" else cfg["dark_palette"]
        apply(want)
        if cfg["mode"] != "manual":
            set_override(cfg, now)
        print(palette_mode(want))
        return

    nightlight(cfg, now)
    if cfg["mode"] == "manual":
        return
    if read_override(cfg, now):
        return
    want = scheduled_variant(cfg, now)
    if want and apply(want):
        print(palette_mode(want))

if __name__ == "__main__":
    main()
