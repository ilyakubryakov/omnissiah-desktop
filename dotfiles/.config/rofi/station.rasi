@import "~/.local/state/theme/current/rofi-colors.rasi"

configuration {
    font: "Inter 14";
    drun-display-format: "{name}";
    display-drun: "Apps";
    scroll-method: 0;
}
* {
    background-color: transparent;
    text-color: @th-fg;
    border-color: @th-border;
    spacing: 12px;
}
window {
    background-color: @th-bg;
    transparency: "real";
    width: 960px;
    location: center;
    anchor: center;
    border: 1px;
    border-radius: 16px;
    padding: 28px;
}
mainbox { children: [mode-switcher, inputbar, message, listview]; }
mode-switcher { spacing: 6px; padding: 4px; background-color: @th-surface; border-radius: 12px; }
button { padding: 10px 18px; border-radius: 8px; text-color: @th-muted; }
button selected { background-color: @th-selected; text-color: @th-bright; }
inputbar { padding: 16px; spacing: 16px; children: [prompt, entry]; background-color: @th-input; border-radius: 10px; }
prompt { text-color: @th-accent; }
entry { placeholder: "Search..."; placeholder-color: @th-dim; }
message { padding: 0px 4px 10px; }
textbox { font: "Inter 10"; text-color: @th-muted; }
listview { lines: 10; columns: 1; fixed-height: true; scrollbar: false; spacing: 5px; }
element { padding: 12px; border-radius: 8px; spacing: 14px; }
element normal.normal { background-color: transparent; text-color: @th-fg; }
element alternate.normal { background-color: transparent; text-color: @th-fg; }
element selected.normal { background-color: @th-selected; text-color: @th-bright; }
element-icon { size: 26px; background-color: inherit; }
element-text { background-color: inherit; text-color: inherit; highlight: @th-highlight; vertical-align: 0.5; }
