[Unit]
Description=Omnissiah Idle and screen lock
PartOf=omnissiah.target graphical-session.target
After=graphical-session.target omnissiah-prepare.service

[Service]
ExecStart=%h/.config/hypr/scripts/idle.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
UMask=0077
