[Unit]
Description=Omnissiah Desktop panels and Control Center
PartOf=omnissiah.target graphical-session.target
After=graphical-session.target omnissiah-prepare.service

[Service]
ExecStart=/usr/bin/quickshell -n -p %h/.config/quickshell/station.qml
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
UMask=0077
