[Unit]
Description=Omnissiah Clipboard history
PartOf=omnissiah.target graphical-session.target
After=graphical-session.target omnissiah-prepare.service

[Service]
ExecStart=/usr/bin/wl-paste --watch cliphist store
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
UMask=0077
