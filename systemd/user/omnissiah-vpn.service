[Unit]
Description=Omnissiah saved VPN connections
PartOf=omnissiah.target graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.local/state/station-vpn-autostart.json

[Service]
Type=oneshot
ExecStart=%h/.local/bin/station-desktop vpn-login
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
