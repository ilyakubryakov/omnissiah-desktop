[Unit]
Description=Omnissiah Local resource telemetry
PartOf=omnissiah.target graphical-session.target
After=graphical-session.target omnissiah-prepare.service

[Service]
ExecStart=%h/.local/bin/station-status
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
UMask=0077
