# theme:out=rofi-colors.rasi
# theme:comment=//
* {
    th-bg:       {{window_background}};
    th-input:    {{background}};
    th-surface:  {{dark_background}};
    th-border:   {{light_background}};
    th-fg:       {{foreground}};
    th-dim:      {{dim_foreground}};
    th-muted:    {{muted}};
    th-bright:   {{bright_foreground}};
    th-accent:   {{accent}};
    th-highlight: bold {{accent}};
    th-selected: {{selection}};
}
