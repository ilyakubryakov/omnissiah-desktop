# theme:out=vscode-theme.json
# theme:comment=//
{
    "name": "OniNix palette",
    "type": "{{mode}}",
    "semanticHighlighting": true,
    "colors": {
        "focusBorder": "{{accent}}80",
        "foreground": "{{foreground}}",
        "descriptionForeground": "{{muted}}",
        "errorForeground": "{{bright_red}}",
        "icon.foreground": "{{muted}}",
        "selection.background": "{{selection}}",
        "widget.shadow": "{{dark_background}}80",
        "textLink.foreground": "{{bright_blue}}",
        "textLink.activeForeground": "{{bright_yellow}}",
        "textPreformat.foreground": "{{orange}}",
        "textBlockQuote.background": "{{light_background}}",
        "textBlockQuote.border": "{{accent}}",
        "textCodeBlock.background": "{{dark_background}}",

        "button.background": "{{accent}}",
        "button.foreground": "{{dark_background}}",
        "button.hoverBackground": "{{bright_yellow}}",
        "button.secondaryBackground": "{{light_background}}",
        "button.secondaryForeground": "{{foreground}}",
        "badge.background": "{{accent}}",
        "badge.foreground": "{{dark_background}}",
        "progressBar.background": "{{accent}}",
        "checkbox.background": "{{light_background}}",
        "checkbox.border": "{{dim_foreground}}",

        "input.background": "{{dark_background}}",
        "input.border": "{{light_background}}",
        "input.foreground": "{{foreground}}",
        "input.placeholderForeground": "{{dim_foreground}}",
        "inputOption.activeBorder": "{{accent}}",
        "inputValidation.errorBorder": "{{red}}",
        "inputValidation.warningBorder": "{{yellow}}",
        "dropdown.background": "{{dark_background}}",
        "dropdown.border": "{{light_background}}",

        "scrollbarSlider.background": "{{dim_foreground}}40",
        "scrollbarSlider.hoverBackground": "{{dim_foreground}}80",
        "scrollbarSlider.activeBackground": "{{accent}}80",

        "titleBar.activeBackground": "{{dark_background}}",
        "titleBar.activeForeground": "{{muted}}",
        "titleBar.inactiveBackground": "{{dark_background}}",
        "titleBar.inactiveForeground": "{{dim_foreground}}",
        "activityBar.background": "{{dark_background}}",
        "activityBar.foreground": "{{bright_yellow}}",
        "activityBar.inactiveForeground": "{{dim_foreground}}",
        "activityBar.activeBorder": "{{accent}}",
        "activityBarBadge.background": "{{red}}",
        "activityBarBadge.foreground": "{{bright_foreground}}",
        "sideBar.background": "{{faint_background}}",
        "sideBar.foreground": "{{faint_foreground}}",
        "sideBar.border": "{{dark_background}}",
        "sideBarTitle.foreground": "{{muted}}",
        "sideBarSectionHeader.background": "{{faint_background}}",
        "sideBarSectionHeader.foreground": "{{muted}}",
        "list.activeSelectionBackground": "{{selection}}",
        "list.activeSelectionForeground": "{{bright_foreground}}",
        "list.inactiveSelectionBackground": "{{light_background}}",
        "list.hoverBackground": "{{light_background}}",
        "list.focusOutline": "{{accent}}80",
        "list.highlightForeground": "{{bright_yellow}}",
        "list.errorForeground": "{{bright_red}}",
        "list.warningForeground": "{{bright_yellow}}",
        "tree.indentGuidesStroke": "{{dim_foreground}}60",

        "editorGroupHeader.tabsBackground": "{{dark_background}}",
        "editorGroup.border": "{{dark_background}}",
        "tab.activeBackground": "{{background}}",
        "tab.activeForeground": "{{bright_foreground}}",
        "tab.activeBorderTop": "{{accent}}",
        "tab.inactiveBackground": "{{dark_background}}",
        "tab.inactiveForeground": "{{dim_foreground}}",
        "tab.border": "{{dark_background}}",
        "breadcrumb.foreground": "{{dim_foreground}}",
        "breadcrumb.focusForeground": "{{foreground}}",
        "breadcrumb.activeSelectionForeground": "{{bright_yellow}}",

        "editor.background": "{{background}}",
        "editor.foreground": "{{foreground}}",
        "editorCursor.foreground": "{{cursor}}",
        "editor.lineHighlightBackground": "{{light_background}}",
        "editor.lineHighlightBorder": "{{light_background}}",
        "editor.selectionBackground": "{{selection}}",
        "editor.inactiveSelectionBackground": "{{selection}}80",
        "editor.selectionHighlightBackground": "{{selection}}80",
        "editor.wordHighlightBackground": "{{selection}}80",
        "editor.findMatchBackground": "{{accent}}60",
        "editor.findMatchHighlightBackground": "{{accent}}30",
        "editor.rangeHighlightBackground": "{{light_background}}",
        "editorLineNumber.foreground": "{{dim_foreground}}",
        "editorLineNumber.activeForeground": "{{bright_yellow}}",
        "editorGutter.background": "{{background}}",
        "editorWhitespace.foreground": "{{dim_foreground}}50",
        "editorIndentGuide.background1": "{{dim_foreground}}30",
        "editorIndentGuide.activeBackground1": "{{dim_foreground}}90",
        "editorRuler.foreground": "{{light_background}}",
        "editorBracketMatch.background": "{{selection}}",
        "editorBracketMatch.border": "{{accent}}80",
        "editorBracketHighlight.foreground1": "{{yellow}}",
        "editorBracketHighlight.foreground2": "{{magenta}}",
        "editorBracketHighlight.foreground3": "{{cyan}}",
        "editorBracketHighlight.foreground4": "{{orange}}",
        "editorBracketHighlight.foreground5": "{{green}}",
        "editorBracketHighlight.foreground6": "{{blue}}",
        "editorWidget.background": "{{dark_background}}",
        "editorWidget.border": "{{light_background}}",
        "editorSuggestWidget.background": "{{dark_background}}",
        "editorSuggestWidget.selectedBackground": "{{selection}}",
        "editorSuggestWidget.highlightForeground": "{{bright_yellow}}",
        "editorHoverWidget.background": "{{dark_background}}",
        "editorHoverWidget.border": "{{light_background}}",
        "editorError.foreground": "{{bright_red}}",
        "editorWarning.foreground": "{{bright_yellow}}",
        "editorInfo.foreground": "{{bright_blue}}",
        "editorHint.foreground": "{{cyan}}",
        "editorGutter.addedBackground": "{{green}}",
        "editorGutter.modifiedBackground": "{{yellow}}",
        "editorGutter.deletedBackground": "{{red}}",
        "diffEditor.insertedTextBackground": "{{green}}25",
        "diffEditor.removedTextBackground": "{{red}}25",
        "minimap.background": "{{background}}",
        "minimapGutter.addedBackground": "{{green}}",
        "minimapGutter.modifiedBackground": "{{yellow}}",
        "minimapGutter.deletedBackground": "{{red}}",

        "peekView.border": "{{accent}}",
        "peekViewEditor.background": "{{dark_background}}",
        "peekViewResult.background": "{{faint_background}}",
        "peekViewTitle.background": "{{light_background}}",

        "panel.background": "{{faint_background}}",
        "panel.border": "{{light_background}}",
        "panelTitle.activeBorder": "{{accent}}",
        "panelTitle.activeForeground": "{{bright_foreground}}",
        "panelTitle.inactiveForeground": "{{dim_foreground}}",
        "statusBar.background": "{{dark_background}}",
        "statusBar.foreground": "{{muted}}",
        "statusBar.border": "{{dark_background}}",
        "statusBar.debuggingBackground": "{{red}}",
        "statusBar.debuggingForeground": "{{bright_foreground}}",
        "statusBar.noFolderBackground": "{{dark_background}}",
        "statusBarItem.remoteBackground": "{{accent}}",
        "statusBarItem.remoteForeground": "{{dark_background}}",
        "statusBarItem.hoverBackground": "{{light_background}}",
        "notifications.background": "{{dark_background}}",
        "notifications.border": "{{light_background}}",
        "quickInput.background": "{{dark_background}}",
        "quickInputList.focusBackground": "{{selection}}",
        "menu.background": "{{dark_background}}",
        "menu.selectionBackground": "{{selection}}",
        "menu.separatorBackground": "{{light_background}}",

        "gitDecoration.addedResourceForeground": "{{bright_green}}",
        "gitDecoration.modifiedResourceForeground": "{{bright_yellow}}",
        "gitDecoration.deletedResourceForeground": "{{bright_red}}",
        "gitDecoration.untrackedResourceForeground": "{{bright_cyan}}",
        "gitDecoration.ignoredResourceForeground": "{{dim_foreground}}",
        "gitDecoration.conflictingResourceForeground": "{{bright_magenta}}",

        "terminal.background": "{{background}}",
        "terminal.foreground": "{{foreground}}",
        "terminalCursor.foreground": "{{cursor}}",
        "terminal.selectionBackground": "{{selection}}",
        "terminal.ansiBlack": "{{dark_background}}",
        "terminal.ansiRed": "{{red}}",
        "terminal.ansiGreen": "{{green}}",
        "terminal.ansiYellow": "{{yellow}}",
        "terminal.ansiBlue": "{{blue}}",
        "terminal.ansiMagenta": "{{magenta}}",
        "terminal.ansiCyan": "{{cyan}}",
        "terminal.ansiWhite": "{{white}}",
        "terminal.ansiBrightBlack": "{{dim_foreground}}",
        "terminal.ansiBrightRed": "{{bright_red}}",
        "terminal.ansiBrightGreen": "{{bright_green}}",
        "terminal.ansiBrightYellow": "{{bright_yellow}}",
        "terminal.ansiBrightBlue": "{{bright_blue}}",
        "terminal.ansiBrightMagenta": "{{bright_magenta}}",
        "terminal.ansiBrightCyan": "{{bright_cyan}}",
        "terminal.ansiBrightWhite": "{{bright_white}}"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"],
          "settings": { "foreground": "{{dim_foreground}}", "fontStyle": "italic" } },
        { "scope": ["string", "string.quoted", "markup.inline.raw"],
          "settings": { "foreground": "{{green}}" } },
        { "scope": ["string.regexp", "constant.character.escape"],
          "settings": { "foreground": "{{bright_red}}" } },
        { "scope": ["constant.numeric", "constant.language.boolean"],
          "settings": { "foreground": "{{bright_magenta}}" } },
        { "scope": ["constant", "constant.language", "support.constant", "variable.other.constant"],
          "settings": { "foreground": "{{orange}}" } },
        { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
          "settings": { "foreground": "{{red}}" } },
        { "scope": ["keyword.operator", "punctuation.accessor"],
          "settings": { "foreground": "{{bright_red}}" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call"],
          "settings": { "foreground": "{{bright_yellow}}" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
          "settings": { "foreground": "{{cyan}}" } },
        { "scope": ["variable.parameter", "meta.parameter"],
          "settings": { "foreground": "{{faint_foreground}}" } },
        { "scope": ["variable", "meta.definition.variable"],
          "settings": { "foreground": "{{foreground}}" } },
        { "scope": ["variable.language", "variable.language.this", "variable.language.self"],
          "settings": { "foreground": "{{magenta}}" } },
        { "scope": ["entity.name.tag", "support.type.property-name", "meta.object-literal.key", "entity.name.tag.yaml"],
          "settings": { "foreground": "{{yellow}}" } },
        { "scope": ["entity.other.attribute-name"],
          "settings": { "foreground": "{{orange}}" } },
        { "scope": ["meta.preprocessor", "entity.name.function.preprocessor", "keyword.control.import", "keyword.control.directive"],
          "settings": { "foreground": "{{bright_red}}" } },
        { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
          "settings": { "foreground": "{{muted}}" } },
        { "scope": ["entity.name.namespace", "entity.name.module"],
          "settings": { "foreground": "{{bright_cyan}}" } },
        { "scope": ["markup.heading", "entity.name.section"],
          "settings": { "foreground": "{{bright_yellow}}", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["markup.underline.link", "string.other.link"],
          "settings": { "foreground": "{{bright_blue}}" } },
        { "scope": ["markup.inserted"], "settings": { "foreground": "{{bright_green}}" } },
        { "scope": ["markup.deleted"], "settings": { "foreground": "{{bright_red}}" } },
        { "scope": ["markup.changed"], "settings": { "foreground": "{{bright_yellow}}" } },
        { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{bright_red}}" } },
        { "scope": ["invalid.deprecated"],
          "settings": { "foreground": "{{dim_foreground}}", "fontStyle": "strikethrough" } }
    ],
    "semanticTokenColors": {
        "namespace": "{{bright_cyan}}",
        "type": "{{cyan}}",
        "class": "{{cyan}}",
        "interface": "{{cyan}}",
        "enum": "{{cyan}}",
        "enumMember": "{{orange}}",
        "typeParameter": "{{cyan}}",
        "function": "{{bright_yellow}}",
        "method": "{{bright_yellow}}",
        "macro": "{{bright_red}}",
        "parameter": "{{faint_foreground}}",
        "property": "{{yellow}}",
        "variable.readonly": "{{orange}}",
        "keyword": "{{red}}",
        "string": "{{green}}",
        "number": "{{bright_magenta}}",
        "regexp": "{{bright_red}}",
        "comment": "{{dim_foreground}}"
    }
}
