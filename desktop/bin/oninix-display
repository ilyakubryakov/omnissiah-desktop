#!/usr/bin/env python3
import configparser
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from oninix_shell import atomic as write_atomic

STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state')))
OVERLAY = STATE / 'oninix/monitors.conf'
REVERT = STATE / 'oninix/monitors.revert.json'
PROFILE = STATE / 'theme/displays.conf'
REVERT_SECONDS = 20
REVERT_UNIT = 'oninix-display-revert'
APPLIANCES = {'tv'}
OVERLAY_KEYS = {'output', 'mode', 'position', 'scale', 'transform', 'vrr', 'hdr', 'sdrbrightness', 'mirror', 'disabled'}

def roles(path=None):
    config = configparser.ConfigParser(interpolation=None)
    if path is not None:
        with open(path) as source:
            config.read_file(source)
    else:
        for source in (Path('/etc/oninix/monitors.conf'), Path.home() / '.config/oninix/monitors.conf'):
            if config.read(source):
                break
    return config

def overlay():
    config = configparser.ConfigParser(interpolation=None)
    config.optionxform = str
    if OVERLAY.exists():
        config.read(OVERLAY)
    return config

def lua_string(value):
    if any(ord(c) < 32 for c in value):
        raise ValueError('Control characters are not allowed in display settings')
    return json.dumps(value, ensure_ascii=False)

def monitors(everything=False):
    return json.loads(subprocess.check_output(['hyprctl', 'monitors'] + (['all'] if everything else []) + ['-j'], text=True))

def hypr_eval(expr):
    if subprocess.check_output(['hyprctl', 'eval', expr], text=True).strip() != 'ok':
        raise RuntimeError('Hyprland rejected the display change')

def apply(rule):
    fields = ', '.join(f'{key} = {str(value).lower() if isinstance(value, bool) else value if isinstance(value, (int, float)) else lua_string(value)}' for key, value in rule.items())
    hypr_eval('hl.monitor({ ' + fields + ' })')

def monitor_key(monitor, live):
    desc = (monitor.get('description') or '').strip()
    if desc and not re.search(r'[\[\]\n]', desc) and sum((m.get('description') or '').strip() == desc for m in live) == 1:
        return 'desc:' + desc
    return monitor['name']

def primary_output(config, live, saved=None):
    saved = saved or overlay()
    names = {m['name'] for m in live}
    found = None
    if saved.has_section('primary'):
        key = saved['primary'].get('display', '')
        found = next((m['name'] for m in live if monitor_key(m, live) == key and not m.get('disabled')), None)
    if os.environ.get('ONINIX_LAPTOP') == '1' and 'main' in config:
        outside = sorted(m['name'] for m in live if m['name'] != config['main'].get('output') and not m.get('disabled'))
        if outside:
            return found if found in outside else outside[0]
    if found:
        return found
    for role in ('main', 'vm'):
        if role in config and config[role].get('output') in names:
            return config[role]['output']
    return None

def tv_rule(config, active):
    tv = config['tv']
    if any(m['name'] == tv['output'] for m in active):
        return {'output': tv['output'], 'disabled': True}
    scale = tv.getfloat('scale')
    mode = tv['mode']
    match = re.fullmatch(r'(\d+)x(\d+)@[\d.]+', mode)
    if not match or scale <= 0:
        raise ValueError('TV needs an explicit WxH@Hz mode and positive scale')
    main_name = primary_output(config, active)
    main = next((m for m in active if m['name'] == main_name), None)
    position = 'auto-up'
    if main:
        width, height = map(int, match.groups())
        x = round(main['x'] + (main['width'] / main['scale'] - width / scale) / 2)
        y = round(main['y'] - height / scale)
        position = f'{x}x{y}'
    return {'output': tv['output'], 'mode': mode, 'scale': scale, 'position': position, 'disabled': False}

def profile(name):
    if name not in {'desk', 'extended'}:
        raise ValueError('Unknown display profile')
    config = roles()
    if 'tv' not in config:
        raise ValueError('This host has no dedicated TV profile')
    active = monitors()
    if not primary_output(config, active):
        raise ValueError('Main display must be connected before changing the TV')
    connected = monitors(everything=True)
    tv = config['tv']['output']
    if name == 'extended' and not any(m['name'] == tv for m in connected):
        raise ValueError('TV is not connected')
    if name == 'desk':
        clients = json.loads(subprocess.check_output(['hyprctl', 'clients', '-j'], text=True))
        tv_id = next((m['id'] for m in active if m['name'] == tv), None)
        for client in clients:
            minimized = (client.get('workspace') or {}).get('name') == 'special:minimized'
            if tv_id is not None and client['monitor'] == tv_id and not minimized:
                if not re.fullmatch(r'0x[0-9a-fA-F]+', client['address']):
                    continue
                hypr_eval('hl.dispatch(hl.dsp.window.move({ window = ' + lua_string('address:' + client['address']) + ', workspace = "1", follow = false }))')
        apply({'output': tv, 'disabled': True})
    elif not any(m['name'] == tv for m in active):
        apply(tv_rule(config, active))
    write_atomic(PROFILE, 'profile=' + name + '\n')

def hdr_capable(name):
    for path in Path('/sys/class/drm').glob(f'card*-{name}/edid'):
        try:
            edid = path.read_bytes()
        except OSError:
            return None
        if len(edid) < 128:
            return None
        for start in range(128, len(edid) - 127, 128):
            block = edid[start:start + 128]
            if block[0] != 0x02:
                continue
            i, end = 4, min(block[2], 127)
            while i < end:
                tag, length = block[i] >> 5, block[i] & 31
                if tag == 7 and length >= 1 and block[i + 1] == 6:
                    return True
                i += length + 1
        return False
    return None

def group_modes(available):
    modes = {}
    for entry in available:
        match = re.fullmatch(r'(\d+)x(\d+)@([\d.]+)Hz', entry)
        if match:
            w, h, rate = int(match[1]), int(match[2]), round(float(match[3]), 2)
            rates = modes.setdefault((w, h), [])
            if rate not in rates:
                rates.append(rate)
    return [{'width': w, 'height': h, 'rates': sorted(rates, reverse=True)}
            for (w, h), rates in sorted(modes.items(), key=lambda item: item[0][0] * item[0][1], reverse=True)]

def pending_seconds():
    try:
        return max(0, round(json.loads(REVERT.read_text())['deadline'] - time.time()))
    except (OSError, ValueError, KeyError):
        return None

def data():
    config = roles()
    saved = overlay()
    live = monitors(everything=True)
    role_of = {config[s]['output']: s for s in config.sections() if 'output' in config[s]}
    primary = primary_output(config, [m for m in live if not m.get('disabled')], saved)
    tv = config['tv']['output'] if 'tv' in config else None
    displays = []
    for m in live:
        key = monitor_key(m, live)
        entry = saved[key] if saved.has_section(key) else {}
        mirror = next((monitor_key(o, live) for o in live if o['name'] == m.get('mirrorOf')), '')
        displays.append({
            'key': key, 'name': m['name'], 'description': m.get('description') or m['name'],
            'make': m.get('make') or '', 'model': m.get('model') or '',
            'role': role_of.get(m['name'], ''), 'enabled': not m.get('disabled'),
            'primary': m['name'] == primary, 'x': m['x'], 'y': m['y'],
            'width': m['width'], 'height': m['height'], 'refresh': round(m['refreshRate'], 2),
            'scale': m['scale'], 'transform': m['transform'] % 4,
            'vrr': int(entry.get('vrr', 1 if m.get('vrr') else 0)),
            'hdr': m.get('colorManagementPreset') in ('hdr', 'hdredid'),
            'hdrCapable': hdr_capable(m['name']), 'sdrBrightness': m.get('sdrBrightness', 1),
            'mirror': mirror, 'saved': bool(entry), 'modes': group_modes(m.get('availableModes', [])),
        })
    return {'displays': displays, 'pending': pending_seconds(), 'tv': tv,
            'profile': PROFILE.read_text().strip().removeprefix('profile=') if PROFILE.exists() else 'desk'}

def valid_scale(width, height, scale):
    return 0.5 <= scale <= 4 and abs(scale * 120 - round(scale * 120)) < 0.01 \
        and all(abs(n / scale - round(n / scale)) < 0.01 for n in (width, height))

def checked(request, live):
    by_key = {monitor_key(m, live): m for m in live}
    config = roles()
    role_of = {config[s]['output']: s for s in config.sections() if 'output' in config[s]}
    out, boxes = {}, []
    for item in request.get('displays', []):
        m = by_key.get(item.get('key'))
        if not m:
            raise ValueError('A display was unplugged; reopen the tab')
        enabled = bool(item.get('enabled', True))
        match = re.fullmatch(r'(\d+)x(\d+)@([\d.]+)', str(item.get('mode', '')))
        if not match:
            raise ValueError(f'{m["name"]}: bad mode')
        w, h, rate = int(match[1]), int(match[2]), float(match[3])
        if not any(mode['width'] == w and mode['height'] == h and any(abs(r - rate) < 0.02 for r in mode['rates'])
                   for mode in group_modes(m.get('availableModes', []))):
            raise ValueError(f'{m["name"]}: {w}x{h}@{rate:g} is not offered by the display')
        scale = round(float(item.get('scale', 1)), 6)
        if not valid_scale(w, h, scale):
            raise ValueError(f'{m["name"]}: scale {scale:g} does not divide {w}x{h} evenly')
        transform = int(item.get('transform', 0))
        vrr = int(item.get('vrr', 0))
        sdr = round(float(item.get('sdrbrightness', 1)), 2)
        if transform not in range(4) or vrr not in range(3) or not 0.5 <= sdr <= 2:
            raise ValueError(f'{m["name"]}: rotation, VRR or SDR brightness out of range')
        pos = re.fullmatch(r'(-?\d+)x(-?\d+)', str(item.get('position', '')))
        if not pos:
            raise ValueError(f'{m["name"]}: bad position')
        mirror = str(item.get('mirror') or '')
        if mirror and (mirror not in by_key or mirror == item['key']):
            raise ValueError(f'{m["name"]}: cannot mirror that display')
        out[item['key']] = {'output': m['name'], 'mode': f'{w}x{h}@{rate:g}', 'position': f'{pos[1]}x{pos[2]}',
                            'scale': f'{scale:.6f}'.rstrip('0').rstrip('.'), 'transform': str(transform), 'vrr': str(vrr),
                            'hdr': 'true' if item.get('hdr') else 'false', 'sdrbrightness': f'{sdr:g}',
                            'mirror': mirror, 'disabled': 'false' if enabled else 'true'}
        if enabled and not mirror:
            lw, lh = (h, w) if transform % 2 else (w, h)
            boxes.append((m['name'], int(pos[1]), int(pos[2]), round(lw / scale), round(lh / scale)))
    for i, a in enumerate(boxes):
        for b in boxes[i + 1:]:
            if a[1] < b[1] + b[3] and b[1] < a[1] + a[3] and a[2] < b[2] + b[4] and b[2] < a[2] + a[4]:
                raise ValueError(f'{a[0]} and {b[0]} overlap')
    desktops = [k for k, v in out.items() if v['disabled'] == 'false' and not v['mirror'] and role_of.get(v['output']) not in APPLIANCES]
    if not desktops:
        raise ValueError('At least one desktop display must stay on')
    primary = request.get('primary') or ''
    if primary not in desktops:
        raise ValueError('The primary display must be an enabled, unmirrored desktop display')
    return out, primary, role_of

def snapshot():
    return {'overlay': OVERLAY.read_text() if OVERLAY.exists() else None,
            'profile': PROFILE.read_text() if PROFILE.exists() else None}

def restore_file(path, text):
    if text is None:
        path.unlink(missing_ok=True)
    else:
        write_atomic(path, text)

def schedule_revert():
    subprocess.run(['systemctl', '--user', 'stop', REVERT_UNIT + '.timer'], stderr=subprocess.DEVNULL)
    env = [f'--setenv={k}={os.environ[k]}' for k in ('HYPRLAND_INSTANCE_SIGNATURE', 'XDG_RUNTIME_DIR', 'WAYLAND_DISPLAY') if k in os.environ]
    subprocess.run(['systemd-run', '--user', '--quiet', '--collect', '--unit=' + REVERT_UNIT, f'--on-active={REVERT_SECONDS}',
                    *env, str(Path(__file__).resolve()), 'revert'], check=True)

def commit(text, before, tv_on=None, primary=None):
    state = json.loads(REVERT.read_text()) if REVERT.exists() else {**before, 'primary': primary}
    state['deadline'] = time.time() + REVERT_SECONDS
    write_atomic(REVERT, json.dumps(state))
    try:
        if tv_on is not None:
            profile('extended' if tv_on else 'desk')
        write_atomic(OVERLAY, text)
        subprocess.run(['hyprctl', 'reload'], check=True, stdout=subprocess.DEVNULL)
        schedule_revert()
    except BaseException:
        try:
            revert()
        except Exception:
            pass
        raise

def render(saved):
    lines = ['# Control Center display settings for this machine. Overrides monitors.conf.']
    for section in saved.sections():
        lines.append(f'\n[{section}]')
        lines += [f'{key}={value}' for key, value in saved[section].items()]
    return '\n'.join(lines) + '\n'

def move_workspaces(old, new):
    if not old or not new or old == new:
        return
    hypr_eval('local m = hl.get_monitor(' + lua_string(new) + ') if m then for _, ws in ipairs(hl.get_workspaces()) do '
              'local n = tonumber(ws.name) if not ws.special and n and n >= 1 and n <= 10 and ws.monitor and ws.monitor.name == '
              + lua_string(old) + ' then hl.dispatch(hl.dsp.workspace.move({ workspace = ws, monitor = m })) end end end')

def gather_workspaces(output):
    if not output:
        return
    hypr_eval('local m = hl.get_monitor(' + lua_string(output) + ') if m then for _, ws in ipairs(hl.get_workspaces()) do '
              'local n = tonumber(ws.name) if not ws.special and n and n >= 1 and n <= 10 and ws.monitor and ws.monitor.name ~= '
              + lua_string(output) + ' then hl.dispatch(hl.dsp.workspace.move({ workspace = ws, monitor = m })) end end end')

def apply_layout(request):
    live = monitors(everything=True)
    config = roles()
    before = snapshot()
    old_primary = primary_output(config, [m for m in live if not m.get('disabled')])
    entries, primary, role_of = checked(request, live)
    saved = overlay()
    tv_on = None
    for key, entry in entries.items():
        if role_of.get(entry['output']) == 'tv':
            want = entry.pop('disabled') == 'false'
            have = not next(m for m in live if m['name'] == entry['output']).get('disabled')
            tv_on = want if want != have else None
        if not saved.has_section(key):
            saved.add_section(key)
        saved[key].clear()
        saved[key].update({k: v for k, v in entry.items() if k in OVERLAY_KEYS and v != ''})
    if saved.has_section('primary'):
        saved.remove_section('primary')
    saved.add_section('primary')
    saved['primary'].update({'display': primary, 'output': entries[primary]['output']})
    commit(render(saved), before, tv_on, old_primary)
    move_workspaces(old_primary, entries[primary]['output'])

def forget(key):
    saved = overlay()
    if not saved.has_section(key):
        return
    before = snapshot()
    old_primary = primary_output(roles(), monitors())
    saved.remove_section(key)
    if saved.has_section('primary') and saved['primary'].get('display') == key:
        saved.remove_section('primary')
    commit(render(saved), before, primary=old_primary)

def confirm():
    subprocess.run(['systemctl', '--user', 'stop', REVERT_UNIT + '.timer'], stderr=subprocess.DEVNULL)
    REVERT.unlink(missing_ok=True)

def revert():
    subprocess.run(['systemctl', '--user', 'stop', REVERT_UNIT + '.timer'], stderr=subprocess.DEVNULL)
    try:
        before = json.loads(REVERT.read_text())
    except (OSError, ValueError):
        return
    restore_file(OVERLAY, before.get('overlay'))
    restore_file(PROFILE, before.get('profile'))
    REVERT.unlink(missing_ok=True)
    subprocess.run(['hyprctl', 'reload'], check=True, stdout=subprocess.DEVNULL)
    gather_workspaces(before.get('primary'))

def main():
    args = sys.argv[1:]
    try:
        if args == ['data']:
            print(json.dumps(data()))
        elif args == ['apply']:
            apply_layout(json.load(sys.stdin))
            print('{}')
        elif len(args) == 2 and args[0] == 'forget':
            forget(args[1])
            print('{}')
        elif args in (['confirm'], ['revert']):
            confirm() if args[0] == 'confirm' else revert()
            print('{}')
        elif len(args) == 2 and args[0] == 'output':
            config = roles()
            if args[1] == 'main':
                print(primary_output(config, monitors()) or config['main']['output'])
            else:
                print(config[args[1]]['output'] if args[1] in config else '')
        elif len(args) == 2 and args[0] == 'profile':
            profile(args[1])
        elif args == ['toggle-tv']:
            config = roles()
            if 'tv' not in config:
                raise ValueError('This host has no dedicated TV profile')
            profile('desk' if any(m['name'] == config['tv']['output'] for m in monitors()) else 'extended')
        elif args == ['wake-main']:
            output = primary_output(roles(), monitors())
            if not output:
                raise SystemExit('Main display is not connected')

            def dpms(action):
                subprocess.run(['hyprctl', 'eval', 'hl.dispatch(hl.dsp.dpms({ action = ' + lua_string(action) + ', monitor = ' + lua_string(output) + ' }))'], check=True)
            try:
                dpms('disable')
                time.sleep(1)
            finally:
                dpms('enable')
        else:
            raise SystemExit('Usage: oninix-display data | apply < JSON | forget KEY | confirm | revert | '
                             'profile desk|extended | toggle-tv | wake-main | output ROLE')
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as error:
        if args and args[0] in {'data', 'apply', 'forget', 'confirm', 'revert'}:
            print(json.dumps({'error': str(error)}))
            sys.exit(1)
        raise

if __name__ == '__main__':
    main()
