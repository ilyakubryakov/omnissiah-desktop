#!/usr/bin/env python3
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import selectors
import shutil
import time
import subprocess
import sys
import tempfile
import urllib.parse

SHARE = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SHARE / 'lib'))
import oninix_notifications as notes
import oninix_shell as shell
import oninix_gaming as gaming
sys.path.insert(0, str(SHARE / 'themes'))
import ui_metrics

ENV = {**os.environ, 'LC_ALL': 'C'}
PPD = ['busctl', '--system']
PPD_IFACE = ['net.hadess.PowerProfiles', '/net/hadess/PowerProfiles', 'net.hadess.PowerProfiles']

def run(args, data=None, timeout=6):
    return subprocess.run([str(a) for a in args], input=data, capture_output=True,
                          timeout=timeout, check=True, env=ENV).stdout

def runtime():
    base = os.environ.get('XDG_RUNTIME_DIR')
    if not base:
        raise RuntimeError('The graphical session runtime directory is unavailable')
    path = Path(base) / 'oninix-desktop'
    path.mkdir(mode=0o700, exist_ok=True)
    return path

def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default

def save(path, value):
    shell.atomic(path, json.dumps(value))

def modes():
    return run(['makoctl', 'mode']).decode().splitlines()

def nightlight():
    return json.loads(run(['oninix-theme-schedule', '--status']))['nightlight']

def set_dnd(value):
    run(['makoctl', 'mode', '-a' if value else '-r', 'do-not-disturb'])

def audio_defaults():
    objects = json.loads(run(['pw-dump']))
    configured = {'sink': None, 'source': None}
    available = {'sink': set(), 'source': set()}
    for obj in objects:
        props = obj.get('info', {}).get('props', {})
        for kind in available:
            if props.get('media.class') == 'Audio/' + ('Sink' if kind == 'sink' else 'Source'):
                available[kind].add(props.get('node.name'))
        if obj.get('type') == 'PipeWire:Interface:Metadata' and obj.get('props', {}).get('metadata.name') == 'default':
            for entry in obj.get('metadata', []):
                for kind in configured:
                    if entry.get('subject') == 0 and entry.get('key') == 'default.configured.audio.' + kind:
                        value = entry.get('value', {})
                        if isinstance(value, str):
                            value = json.loads(value)
                        configured[kind] = value.get('name')
    return configured, available

def set_audio_default(kind, name):
    command = ['pw-metadata', '-n', 'default']
    key = 'default.configured.audio.' + kind
    if name is None:
        run(command + ['-d', '0', key])
    else:
        run(command + ['0', key, json.dumps({'name': name}), 'Spa:String:JSON'])

def profile(name, *, game_prompt=False):
    if name not in {'normal', 'work', 'call', 'game', 'music'}:
        raise ValueError('Unknown desktop mode')
    path = runtime() / 'mode.json'
    with (runtime() / 'mode.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = read_json(path, {})
        if game_prompt:
            entering = name == 'game'
            if (old.get('name') == 'game') == entering:
                return
            guard = 'assert(require("gaming").has_games() == ' + str(entering).lower() + ')'
            if run(['hyprctl', 'eval', guard]).strip() != b'ok':
                return
        audio, available = audio_defaults()
        current = {'dnd': 'do-not-disturb' in modes(), 'nightlight': nightlight(),
                   **{'audio_' + k: v for k, v in audio.items()}}
        base = {**current, **old.get('base', {})}
        for key, value in current.items():
            if old and value != old.get('applied', {}).get(key):
                base[key] = value
        target = base.copy()
        game_state = old.get('gaming', {})
        if name != 'normal':
            target['dnd'] = name != 'work'
            if name == 'game':
                target['nightlight'] = False
            devices = read_json(shell.state() / 'oninix/work-mode-devices.json', {}).get(name, {})
            for kind in ('sink', 'source'):
                device = devices.get(kind)
                if device:
                    if device not in available[kind]:
                        raise ValueError('The selected ' + kind + ' is disconnected. Choose an available device in Work modes.')
                    target['audio_' + kind] = device
        try:
            for kind in ('sink', 'source'):
                if target['audio_' + kind] != current['audio_' + kind]:
                    set_audio_default(kind, target['audio_' + kind])
            set_dnd(target['dnd'])
            if target['nightlight'] != current['nightlight']:
                run(['oninix-theme-schedule', '--nightlight', 'on' if target['nightlight'] else 'off'])
            if name == 'music':
                run(['oninix-audio', 'music', 'on'])
            elif old.get('name') == 'music':
                run(['oninix-audio', 'music', 'off'])
            if name == 'game' and old.get('name') != 'game':
                run(['makoctl', 'mode', '-a', 'gaming'])
                game_state = gaming.enter()
            elif old.get('name') == 'game' and name != 'game':
                run(['makoctl', 'mode', '-r', 'gaming'])
                gaming.leave(game_state)
        except Exception:
            rollback = [lambda: set_dnd(current['dnd'])]
            rollback.extend(lambda k=k: set_audio_default(k, current['audio_' + k]) for k in ('sink', 'source'))
            if target['nightlight'] != current['nightlight']:
                rollback.append(lambda: run(['oninix-theme-schedule', '--nightlight', 'on' if current['nightlight'] else 'off']))
            if name == 'music' and old.get('name') != 'music':
                rollback.append(lambda: run(['oninix-audio', 'music', 'off']))
            elif old.get('name') == 'music' and name != 'music':
                rollback.append(lambda: run(['oninix-audio', 'music', 'on']))
            if name == 'game' and old.get('name') != 'game':
                rollback.append(lambda: run(['makoctl', 'mode', '-r', 'gaming']))
            elif old.get('name') == 'game' and name != 'game':
                rollback.append(lambda: run(['makoctl', 'mode', '-a', 'gaming']))
            for restore in rollback:
                try:
                    restore()
                except Exception:
                    pass
            raise
        if name == 'normal':
            path.unlink(missing_ok=True)
        else:
            save(path, {'name': name, 'base': base, 'applied': target, 'gaming': game_state if name == 'game' else {}})
        if old.get('name', 'normal') != name:
            previous = old.get('name', 'normal').capitalize()
            try:
                run(['logger', '-t', 'oninix-mode', f'{name.capitalize()} mode on (was {previous})'])
            except (OSError, subprocess.SubprocessError):
                pass

def game_offer(target):
    entering = target == 'game'
    if (read_json(runtime() / 'mode.json', {}).get('name') == 'game') == entering:
        return
    if entering:
        action, title = 'Enable Game mode', 'Game started'
        body = 'Click to enable Game mode and free resources by pausing local AI and selected apps.'
    else:
        action, title = 'Return to Normal', 'Game closed'
        body = 'Click to return to Normal and restore paused apps and services.'
    chosen = subprocess.run(['notify-send', '--app-name=Game mode', '--icon=input-gaming', '--wait',
                             '--expire-time=15000', '--action=default=' + action, title, body],
                            capture_output=True, text=True, env=ENV).stdout.strip()
    if chosen == 'default':
        profile(target, game_prompt=True)

def split_nm(line):
    fields, field, escaped = [], '', False
    for char in line:
        if escaped:
            field += char
            escaped = False
        elif char == chr(92):
            escaped = True
        elif char == ':':
            fields.append(field)
            field = ''
        else:
            field += char
    fields.append(field)
    return fields

def battery_watts(battery):
    try:
        if (battery / 'power_now').exists():
            return round(int((battery / 'power_now').read_text()) / 1e6, 1)
        return round(int((battery / 'current_now').read_text()) * int((battery / 'voltage_now').read_text()) / 1e12, 1)
    except (OSError, ValueError):
        return None

def laptop_state():
    result = {'battery': None, 'brightness': None, 'profile': None, 'profiles': []}
    for battery in Path('/sys/class/power_supply').glob('*'):
        try:
            if (battery / 'type').read_text().strip() != 'Battery':
                continue
            if (battery / 'scope').exists() and (battery / 'scope').read_text().strip() == 'Device':
                continue
            result['battery'] = {'percent': int((battery / 'capacity').read_text()),
                                 'status': (battery / 'status').read_text().strip(),
                                 'watts': battery_watts(battery)}
            break
        except (OSError, ValueError):
            continue
    try:
        result['brightness'] = round(int(run(['brightnessctl', '-c', 'backlight', 'get'])) * 100 /
                                     int(run(['brightnessctl', '-c', 'backlight', 'max'])))
    except (OSError, ValueError, ZeroDivisionError, subprocess.SubprocessError):
        pass
    try:
        result['profile'] = json.loads(run(PPD + ['--json=short', 'get-property'] + PPD_IFACE + ['ActiveProfile'],
                                           timeout=2))['data']
        raw = json.loads(run(PPD + ['--json=short', 'get-property'] + PPD_IFACE + ['Profiles'], timeout=2))
        result['profiles'] = [item['Profile']['data'] for item in raw['data']]
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        pass
    return result

def network_state():
    links = []
    lines = run(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'device']).decode().splitlines()
    for fields in map(split_nm, lines):
        if len(fields) < 4 or fields[1] not in {'ethernet', 'wifi'} or fields[2] != 'connected':
            continue
        device = fields[0]
        details = run(['nmcli', '-t', '-f', 'GENERAL.CON-UUID,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,IP6.DNS', 'device', 'show', device]).decode().splitlines()
        values = {}
        for line in details:
            key, _, value = line.partition(':')
            values.setdefault(key.split('[')[0], []).append(value.replace('\\:', ':'))
        def first(key):
            return next(iter(values.get(key, [])), '')
        stats = Path('/sys/class/net') / device / 'statistics'
        def counter(name):
            try: return int((stats / name).read_text())
            except (OSError, ValueError): return None
        links.append({'device': device, 'name': fields[3], 'type': fields[1],
                      'uuid': first('GENERAL.CON-UUID'), 'address': first('IP4.ADDRESS'),
                      'gateway': first('IP4.GATEWAY'), 'dns': values.get('IP4.DNS', []) + values.get('IP6.DNS', []),
                      'received': counter('rx_bytes'), 'sent': counter('tx_bytes')})
    connectivity = run(['nmcli', '-t', '-f', 'CONNECTIVITY', 'general']).decode().strip()
    return {'connectivity': connectivity, 'links': links, 'timestamp': time.time()}

def network_dns(provider, uuid):
    state = network_state()
    link = next((x for x in state['links'] if x['uuid'] == uuid), None)
    if not link:
        raise ValueError('Connection is no longer active')
    servers = {'dhcp': '', 'cloudflare': '1.1.1.1,1.0.0.1', 'google': '8.8.8.8,8.8.4.4'}.get(provider)
    if servers is None:
        raise ValueError('Unknown DNS provider')
    run(['nmcli', 'connection', 'modify', 'uuid', uuid,
         'ipv4.ignore-auto-dns', 'no' if provider == 'dhcp' else 'yes', 'ipv4.dns', servers,
         'ipv6.ignore-auto-dns', 'no' if provider == 'dhcp' else 'yes', 'ipv6.dns', ''])
    run(['nmcli', 'device', 'reapply', link['device']])

def controls():
    result = {'mode': read_json(runtime() / 'mode.json', {}).get('name', 'normal'), 'capture': capture_settings()}
    if os.environ.get('ONINIX_LAPTOP') == '1':
        result['laptop'] = laptop_state()
    for key, fn in [('dnd', lambda: 'do-not-disturb' in modes()), ('nightlight', nightlight)]:
        try:
            result[key] = fn()
        except Exception:
            result[key] = None
    try:
        lines = run(['nmcli', '-t', '-f', 'UUID,NAME,TYPE,ACTIVE', 'connection', 'show']).decode().splitlines()
        result['connections'] = [dict(zip(['uuid', 'name', 'type', 'active'], split_nm(line))) for line in lines]
    except Exception:
        result['connections'] = None
    try:
        result['network'] = network_state()
    except Exception:
        result['network'] = None
    try:
        autostart = vpn_autostart()
        result['vpns'] = [{**v, 'autostart': v['id'] in autostart} for v in vpn_profiles()]
    except Exception:
        result['vpns'] = None
    try:
        status = json.loads(run(['tailscale', 'status', '--json'], timeout=2))
        state = status.get('BackendState', 'Unknown')
        result['tailscale'] = {
            'state': state,
            'online': state == 'Running' and status.get('Self', {}).get('Online', False),
            'ips': status.get('TailscaleIPs') or [],
        }
    except Exception:
        result['tailscale'] = {'state': 'Unavailable', 'online': False, 'ips': []}
    try:
        run(['systemctl', '--user', 'is-active', '--quiet', 'oninix-keep-awake.service'])
        result['awake'] = True
    except subprocess.CalledProcessError:
        result['awake'] = False
    except Exception:
        result['awake'] = None
    return result

VPN_PROFILES = Path('/etc/oninix/vpns.json')
VPN_AUTOSTART = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'oninix-vpn-autostart.json'

def vpn_autostart():
    return set(read_json(VPN_AUTOSTART, {}).get('ids', []))

def vpn_profiles():
    profiles = [p for p in read_json(VPN_PROFILES, []) if Path(p['key']).exists()]
    if not profiles:
        return []
    states = run(['systemctl', 'show', '--property', 'ActiveState', '--value'] + [p['unit'] for p in profiles]).decode().split()
    result = []
    for p, state in zip(profiles, states):
        up = Path('/sys/class/net', p['device']).exists()
        running = state in {'active', 'activating', 'reloading'}
        result.append({'id': p['id'], 'name': p['name'], 'unit': p['unit'], 'active': 'yes' if up else 'no',
                       'state': 'connected' if up else 'connecting' if running else 'disconnected'})
    return result

def vpn_profile(vpn_id):
    vpn = next((v for v in vpn_profiles() if v['id'] == vpn_id), None)
    if not vpn:
        raise ValueError('VPN profile is unavailable')
    return vpn

def vpn_login():
    wanted = vpn_autostart()
    for vpn in vpn_profiles():
        if vpn['id'] in wanted and vpn['state'] == 'disconnected':
            run(['systemctl', 'start', vpn['unit']], timeout=30)

def wifi_device():
    for fields in map(split_nm, run(['nmcli', '-t', '-f', 'DEVICE,TYPE', 'device']).decode().splitlines()):
        if len(fields) >= 2 and fields[1] == 'wifi':
            return fields[0]
    return None

def wifi():
    device = wifi_device()
    if not device:
        return {'device': None, 'enabled': False, 'networks': []}
    enabled = run(['nmcli', '-t', '-f', 'WIFI', 'radio']).decode().strip() == 'enabled'
    known = {}
    for fields in map(split_nm, run(['nmcli', '-t', '-f', 'UUID,TYPE', 'connection', 'show']).decode().splitlines()):
        if len(fields) >= 2 and fields[1] == '802-11-wireless':
            ssid = run(['nmcli', '-g', '802-11-wireless.ssid', 'connection', 'show', 'uuid', fields[0]]).decode().strip()
            known.setdefault(ssid.replace(chr(92) + ':', ':'), fields[0])
    networks = {}
    if enabled:
        listing = run(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL,SECURITY', 'device', 'wifi', 'list',
                       'ifname', device, '--rescan', 'no']).decode().splitlines()
        for fields in map(split_nm, listing):
            if len(fields) < 4 or not fields[1]:
                continue
            row = {'ssid': fields[1], 'signal': int(fields[2] or 0), 'security': fields[3].strip(),
                   'active': fields[0] == '*', 'known': known.get(fields[1])}
            best = networks.get(row['ssid'])
            if not best or row['active'] or (not best['active'] and row['signal'] > best['signal']):
                networks[row['ssid']] = row
    rows = sorted(networks.values(), key=lambda r: (not r['active'], r['known'] is None, -r['signal']))
    return {'device': device, 'enabled': enabled, 'networks': rows[:30]}

def wifi_connect(ssid, password):
    state = wifi()
    net = next((n for n in state['networks'] if n['ssid'] == ssid), None)
    if net is None:
        raise ValueError('Network not found; scan again')
    security = net['security'] if net['security'] != '--' else ''
    if net['known'] and not password:
        try:
            run(['nmcli', 'connection', 'up', 'uuid', net['known']], timeout=60)
        except subprocess.SubprocessError:
            raise ValueError('Could not connect to ' + ssid)
        return
    if not security:
        run(['nmcli', 'device', 'wifi', 'connect', ssid, 'ifname', state['device']], timeout=60)
        return
    if '802.1X' in security:
        raise ValueError('Enterprise network: use Network settings')
    if not password:
        raise ValueError('Password required')
    if any(char in password for char in '\r\n\0'):
        raise ValueError('Password must be a single line')
    uuid, created = net['known'], False
    if not uuid:
        key = 'sae' if 'WPA3' in security and 'WPA2' not in security else 'wpa-psk'
        out = run(['nmcli', 'connection', 'add', 'type', 'wifi', 'ifname', state['device'], 'con-name', ssid,
                   'ssid', ssid, 'wifi-sec.key-mgmt', key]).decode()
        uuid, created = re.search(r'\(([0-9a-f-]{36})\)', out).group(1), True
    try:
        with tempfile.NamedTemporaryFile(mode='w', prefix='wifi-', dir=runtime()) as secret:
            secret.write(f'802-11-wireless-security.psk:{password}\n')
            secret.flush()
            run(['nmcli', 'connection', 'up', 'uuid', uuid, 'passwd-file', secret.name], timeout=60)
    except (OSError, subprocess.SubprocessError):
        if created:
            run(['nmcli', 'connection', 'delete', 'uuid', uuid])
        raise ValueError('Could not connect: check the password') from None

STATE_HOME = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state')))
ONINIX_STATE = STATE_HOME / 'oninix'
LAPTOP = os.environ.get('ONINIX_LAPTOP') == '1'
TZ_MANUAL = Path('/var/lib/oninix/timezone-manual')
USER_AUTOSTART = Path.home() / '.config/autostart'
INPUT_DEFAULTS = {'layouts': 'us,ru', 'repeat_rate': '25', 'repeat_delay': '600', 'mouse_speed': '0',
                  'mouse_natural': 'no', 'scroll': '0.7', 'natural': 'yes', 'tap': 'yes'}
INPUT_VALUES = {'layouts': r'[a-z]{2,3}(,[a-z]{2,3}){0,3}', 'repeat_rate': r'[1-7]\d|80', 'repeat_delay': r'[1-9]\d{2}|1000',
                'mouse_speed': r'-?(0(\.\d{1,2})?|1(\.0{1,2})?)', 'mouse_natural': 'yes|no',
                'scroll': r'(0\.(\d[1-9]|[1-9]\d?)|1(\.\d{1,2})?|2(\.0{1,2})?)',
                'natural': 'yes|no', 'tap': 'yes|no'}
IDLE_DEFAULTS = {'lock': 5, 'screen': 6, 'suspend': 0} if LAPTOP else {'lock': 20, 'screen': 0, 'suspend': 0}
DEFAULT_APPS = [
    ('browser', 'Web browser', ['x-scheme-handler/http', 'x-scheme-handler/https', 'text/html']),
    ('mail', 'Email', ['x-scheme-handler/mailto']),
    ('files', 'Files', ['inode/directory']),
    ('pdf', 'PDF', ['application/pdf']),
