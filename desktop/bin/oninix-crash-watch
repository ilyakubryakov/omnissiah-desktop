#!/usr/bin/env python3
from collections import Counter
import os
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from oninix_health import command, coredumps, crash_name, event_time, tooling_crash
from oninix_shell import atomic, state

cursor = state() / 'oninix/crash-watch'
now = int(time.time())
try:
    last = min(int(cursor.read_text()), now)
except (OSError, ValueError):
    last = now - 300

ok, entries = coredumps(f'@{last}')
if not ok:
    sys.exit(0)
names = Counter(crash_name(entry) for entry in entries
                if str(entry.get('COREDUMP_UID')) == str(os.getuid())
                and last <= event_time(entry) < now and not tooling_crash(entry))
if names:
    summary = ', '.join(f'{name} x{count}' for name, count in names.most_common(6))
    result = command('notify-send', '--app-name=OniNix Doctor', 'Application crash', summary, timeout=5)
    if result.returncode:
        sys.exit(0)
atomic(cursor, str(now))
