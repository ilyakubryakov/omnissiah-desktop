#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import oninix_calendar as calendars

def emit(value):
    print(json.dumps(value), flush=True)

def main():
    os.umask(0o077)
    request = {"op": "status"} if "--status" in sys.argv else json.loads(sys.stdin.read(1024 * 1024))
    if not isinstance(request, dict):
        raise calendars.CalendarError("invalid", "Invalid calendar request.")
    result = calendars.handle(request, emit)
    if request.get("op") not in ("status", "setup"):
        subprocess.run(["systemctl", "--user", "start", "--no-block", "caldash.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    emit({"type": "done", "data": result})

if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        emit(dict(type="error", **calendars.safe_error(exc)))
        sys.exit(1)
