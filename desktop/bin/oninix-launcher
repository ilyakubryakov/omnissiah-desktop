#!/usr/bin/env python3
"""Station launcher: applications, projects, files and workstation actions."""

import os
from pathlib import Path
import shlex
import subprocess
import sys

PROJECTS = Path.home() / "Projects"
EXCLUDED = {".git", "node_modules", ".venv", ".terraform", "__pycache__", "target", "build", "dist", ".next", ".cache"}
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "oninix-launcher"


def refresh_cache() -> None:
    import contextlib
    import fcntl

    CACHE.mkdir(parents=True, exist_ok=True)
    with (CACHE / "refresh.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        for mode, generate in [("projects", list_projects), ("files", list_files)]:
            temporary = CACHE / f"{mode}.tmp"
            with temporary.open("w") as stream, contextlib.redirect_stdout(stream):
                generate()
            temporary.replace(CACHE / mode)


def emit_entry(path: Path, icon: str) -> None:
    relative = str(path.relative_to(PROJECTS))
    if any(character in str(path) for character in "\n\r\x00\x1f"):
        return
    print(f"{relative}\0icon\x1f{icon}\x1finfo\x1f{path}")


def list_projects() -> None:
    for directory, children, _ in os.walk(PROJECTS):
        path = Path(directory)
        depth = len(path.relative_to(PROJECTS).parts)
        is_project = (path / ".git").exists() or (path / ".obsidian").is_dir()
        if depth and (is_project or depth == 3 or not children):
            emit_entry(path, "folder")
            children.clear()
        else:
            children[:] = sorted(child for child in children if child not in EXCLUDED and not child.startswith("."))


def list_files() -> None:
    if not PROJECTS.is_dir():
        return
    command = ["fd", "--type", "f", "--hidden", "--print0", "--base-directory", str(PROJECTS)]
    for directory in sorted(EXCLUDED):
        command.extend(["--exclude", directory])
    result = subprocess.run(command, capture_output=True, check=True)
    for name in sorted(result.stdout.split(b"\0")):
        if name:
            emit_entry(PROJECTS / os.fsdecode(name), "text-x-generic")


def launch(command: list[str]) -> None:
    # Manage the chosen application, not the short-lived menu, through UWSM.
    if "HYPRLAND_INSTANCE_SIGNATURE" in os.environ:
        command = ["uwsm", "app", "--", *command]
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def open_selection(action: int) -> None:
    selected = os.environ.get("ROFI_INFO")
    if not selected:
        return
    path = Path(selected)
    directory = path if path.is_dir() else path.parent
    kitty = "/usr/bin/kitty" if Path("/usr/bin/kitty").exists() else "kitty"
    commands = {10: [kitty, "--detach", "--directory", str(directory)], 11: ["code", str(directory)]}
    command = commands.get(action, ["xdg-open", str(path)])
    launch(command)


def workstation_actions() -> dict:
    import shutil

    actions = {
        "shortcuts": ("Keyboard shortcuts & desktop guide", "input-keyboard", ["oninix-shell", "ipc", "call", "cheat", "toggle"]),
        "mixer": ("Audio: devices and application volumes", "audio-volume-high", ["pavucontrol"]),
        "wallpaper": ("Appearance: themes and wallpapers", "preferences-desktop-wallpaper", ["oninix-shell", "ipc", "call", "desktop", "toggle", "appearance"]),
        "nightlight": ("Night light: toggle", "weather-clear-night", ["oninix-theme-schedule", "--nightlight", "toggle"]),
        "network": ("Network connections", "network-wired", ["kitty", "-e", "nmtui"]),
    }
    if shutil.which("makoctl"):
        try:
            modes = subprocess.run(["makoctl", "mode"], capture_output=True, text=True, timeout=2).stdout.splitlines()
        except (OSError, subprocess.TimeoutExpired):
            modes = []
        state = "ON" if "do-not-disturb" in modes else "off"
        actions.update({
            "dnd": (f"Notifications: do not disturb [{state}] - toggle", "notifications-disabled", ["makoctl", "mode", "-t", "do-not-disturb"]),
            "notification-restore": ("Notifications: restore last", "preferences-system-notifications", ["makoctl", "restore"]),
            "notification-dismiss": ("Notifications: dismiss visible", "edit-clear", ["makoctl", "dismiss", "--all"]),
        })
    if shutil.which("ollama"):
        actions.update({
            "webui": ("AI: Open WebUI", "applications-science", ["xdg-open", "http://127.0.0.1:8080"]),
            "comfyui": ("AI: ComfyUI", "applications-graphics", ["xdg-open", "http://127.0.0.1:8188"]),
            "ai-status": ("AI: service status", "utilities-system-monitor", ["kitty", "--hold", "-e", "systemctl", "--no-pager", "status", "ollama.service", "open-webui.service", "comfyui.service"]),
            "ai-start": ("AI: start services", "media-playback-start", ["kitty", "--hold", "-e", "sudo", "systemctl", "start", "local-ai.target"]),
            "ai-stop": ("AI: stop services (ends running jobs)", "media-playback-stop", ["kitty", "--hold", "-e", "sudo", "systemctl", "stop", "local-ai.target"]),
        })
    if shutil.which("virt-manager"):
        actions["vms"] = ("Virtual machines", "computer", ["virt-manager", "--connect", "qemu:///system"])
    return {key: value for key, value in actions.items() if shutil.which(value[2][0])}


def run_actions(action: int) -> None:
    actions = workstation_actions()
    if action == 1:
        selected = actions.get(os.environ.get("ROFI_INFO", ""))
        if selected:
            launch(selected[2])
        return
    print("\0prompt\x1fActions")
    print("\0message\x1fEnter: run   Tab / Shift+Tab: switch   Escape: cancel")
    print("\0no-custom\x1ftrue")
    for key, (label, icon, _) in actions.items():
        print(f"{label}\0icon\x1f{icon}\x1finfo\x1f{key}")


def run_mode(mode: str) -> None:
    action = int(os.environ.get("ROFI_RETV", "0"))
    if mode == "actions":
        run_actions(action)
        return
    if action in {1, 10, 11}:
        open_selection(action)
        return
    print(f"\0prompt\x1f{mode.title()}")
    print("\0message\x1fEnter: open   Alt+1 / Shift+Enter: terminal   Alt+2: VS Code   Tab / Shift+Tab: switch")
    print("\0no-custom\x1ftrue")
    print("\0use-hot-keys\x1ftrue")
    cached = CACHE / mode
    if cached.exists():
        sys.stdout.write(cached.read_text())
    else:
        (list_projects if mode == "projects" else list_files)()


def cached_mode(mode: str, script: str) -> str:
    # Rofi initializes every enabled mode before painting Apps. Reading the two
    # ready indexes with shell builtins + cat avoids two Python startups. Keep
    # selection handling in Python, with argv (including paths with spaces).
    headers = (f"\\0prompt\\37{mode.title()}\\n"
               "\\0message\\37Enter: open   Alt+1 / Shift+Enter: terminal   Alt+2: VS Code   Tab / Shift+Tab: switch\\n"
               "\\0no-custom\\37true\\n\\0use-hot-keys\\37true\\n")
    reader = ('if [ "${ROFI_RETV:-0}" = 0 ] && [ -r "$1" ]; then '
              f"printf {shlex.quote(headers)}; cat -- \"$1\"; "
              'else exec "$2" "$3"; fi')
    return mode.title() + ":" + shlex.join([
        "sh", "-c", reader, "oninix-launcher-mode", str(CACHE / mode), script, mode])


def desktop_cache_stale() -> bool:
    # Rofi never refreshes its drun cache. Store paths have a fixed mtime, so
    # key it on the resolved application directories plus the user's own.
    dirs = [os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))]
    dirs += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    stamp = []
    for directory in dirs:
        applications = Path(directory) / "applications"
        if applications.is_dir():
            stamp.append(f"{applications.resolve()} {applications.stat().st_mtime_ns}")
    stamp = "\n".join(stamp) + "\n"
    path = CACHE / "applications"
    try:
        if path.read_text() == stamp:
            return False
    except OSError:
        pass
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        path.write_text(stamp)
    except OSError:
        pass
    return True


def main() -> None:
    show_actions = sys.argv[1:] == ["--show-actions"]
    if len(sys.argv) > 1 and not show_actions:
        if sys.argv[1] == "refresh":
            refresh_cache()
            return
        if sys.argv[1] not in {"projects", "files", "actions"}:
            raise SystemExit("Usage: oninix-launcher [refresh|projects|files|actions]")
        run_mode(sys.argv[1])
        return
    script = str(Path(__file__).absolute())
    share = Path(__file__).resolve().parents[1]
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "theme"
    icon_state = state / "icon-theme"
    try:
        colors = (state / "current/rofi-colors.rasi").read_text()
    except FileNotFoundError:
        colors = (share / "themes/omnissiah/out/rofi-colors.rasi").read_text()
    try:
        icon_theme = icon_state.read_text().strip() or "Papirus-Dark"
    except OSError:
        icon_theme = "Papirus-Dark"
    reload = ["-drun-reload-desktop-cache"] if desktop_cache_stale() else []
    command = ["rofi", "-no-config", "-drun-use-desktop-cache", *reload, "-show", "Actions" if show_actions else "drun", "-modes",
               ",".join(["drun", cached_mode("projects", script), cached_mode("files", script),
                         "Actions:" + shlex.join([script, "actions"])]),
               "-display-drun", "Apps", "-show-icons", "-icon-theme", icon_theme,
               "-application-fallback-icon", "application-x-executable", "-matching", "fuzzy",
               "-theme", str(share / "hypr/launcher.rasi"), "-theme-str", colors,
               "-kb-accept-alt", "", "-kb-custom-1", "Alt+1,Shift+Return", "-kb-custom-2", "Alt+2",
               "-kb-row-tab", "", "-kb-element-next", "", "-kb-element-prev", "",
               "-kb-mode-next", "Tab,Control+Tab",
               "-kb-mode-previous", "ISO_Left_Tab,Control+ISO_Left_Tab"]
    command.extend(["-run-command", "uwsm app -- {cmd}",
                    "-run-shell-command", "uwsm app -- {terminal} -e {cmd}",
                    "-terminal", "kitty"])
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
