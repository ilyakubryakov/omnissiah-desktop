#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys
import subprocess
import time
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
import oninix_meetings as meetings
os.umask(0o077)
if '--serve' in sys.argv:
    meetings.serve()
else:
    try:
        meetings.rpc({'op':'status'})
    except (OSError, ValueError):
        started = subprocess.run(['systemctl', '--user', 'start', 'oninix-meetings.service'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if started.returncode:
            subprocess.run(['systemd-run', '--user', '--unit=oninix-meetings', '--property=Restart=on-failure', '--property=PartOf=graphical-session.target', '--property=After=pipewire.service', '--property=UMask=0077', '--property=Nice=10', '--property=KillMode=mixed', '--setenv=PATH=' + os.environ.get('PATH', '/run/current-system/sw/bin'), str(Path(__file__).resolve()), '--serve'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        for _ in range(30):
            try:
                meetings.rpc({'op':'status'})
                break
            except (OSError, ValueError):
                time.sleep(.1)
    for line in sys.stdin:
        request = {}
        try:
            if len(line) > 65536:
                raise ValueError('Request too large.')
            request = json.loads(line)
            result = meetings.rpc(request)
        except Exception:
            result = dict(ok=False, requestId=request.get('requestId'), message='Meeting service is unavailable. Start oninix-meetings.service, then reopen this tab.')
        print(json.dumps(result, ensure_ascii=False), flush=True)
