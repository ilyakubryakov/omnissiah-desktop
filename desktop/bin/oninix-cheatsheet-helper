def hypr_rows(binds):
    groups = {}
    for b in binds:
        desc = (b.get('description') or '').strip()
        if not desc or b.get('release'):
            continue
        identity = (desc, b.get('modmask', 0), b.get('submap', ''))
        groups.setdefault(identity, []).append(str(b.get('key') or ('code:' + str(b.get('keycode', '')))))
    rows = []
    for (desc, mask, submap), keys in groups.items():
        mods = [name for bit, name in HYPR_MODS if mask & bit]
        keys = list(dict.fromkeys(keys))
        lowered = {k.lower() for k in keys}
        if lowered == {'left', 'right', 'up', 'down'}:
            key = '← ↑ ↓ →'
        elif lowered == set('0123456789'):
            key = '1…0'
        else:
            key = ' / '.join(HYPR_KEYS.get(k.lower(), k.capitalize() if len(k) > 1 else k.upper()) for k in keys)
        group, title, aliases = HYPR_LABELS.get(desc, ('Launch & tools' if 'focus or start' in desc or desc in {'Slack','Telegram','Thunderbird','Obsidian','Claude','ChatGPT / Codex'} else 'Other shortcuts', desc, ''))
        rows.append({'keys': '+'.join(mods + [key]), 'desc': title, 'group': group,
                     'action': desc, 'keywords': desc + ' ' + aliases,
                     'detail': 'Submap: ' + submap if submap else ''})
    return rows


def hyprland_shortcuts():
    """Binds that carry a description in hypr/binds.lua, as Hyprland itself
    reports them. An undescribed bind (such as a media key) is deliberately left off the sheet."""
    try:
        signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
        if not signature:
            display = os.environ.get('WAYLAND_DISPLAY')
            if not display:
                return []
            instances = subprocess.run(['hyprctl', 'instances', '-j'], capture_output=True, text=True, timeout=3)
            matches = [i['instance'] for i in json.loads(instances.stdout) if i.get('wl_socket') == display]
            if len(matches) != 1:
                return []
            signature = matches[0]
        out = subprocess.run(["hyprctl", '-i', signature, "binds", "-j"], capture_output=True, text=True, timeout=5)
        binds = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []
    return hypr_rows(binds) if out.returncode == 0 and isinstance(binds, list) else []


def desktop_name(filename):
    for base in (HOME / ".local/share/applications", Path("/usr/share/applications")):
        p = base / filename
        if p.is_file():
            for line in p.read_text(errors="replace").splitlines():
                if line.startswith("Name="):
                    return line[5:].strip()
    return None


def kitty_shortcuts():
    """kitty.conf `map <keys> <action>`. The generated file includes others,
    so read the one kitty actually loads."""
    path = CONFIG / "kitty" / "kitty.conf"
    rows = []
    for source in ([path] + [Path(l.split(None, 1)[1].strip()).expanduser()
                             for l in (path.read_text(errors="replace").splitlines()
                                       if path.is_file() else [])
                             if l.startswith("include ")]):
        if not source.is_file():
            continue
        for line in source.read_text(errors="replace").splitlines():
            if not line.startswith("map "):
                continue
            parts = line[4:].split(None, 1)
            if len(parts) == 2:
                rows.append({"keys": pretty_keys(parts[0]), "desc": short_action(parts[1])})
    return rows


def short_action(action):
    """A kitty binding's action can be a whole command line. The verb and its
    first argument say what it does; the rest is plumbing."""
    action = action.strip()
    if len(action) <= 40:
        return action
    words = action.split()
    head = " ".join(words[:2])
    if "search.py" in action:
        return "search scrollback"
    return head + " ..."


def pretty_keys(combo):
    names = {"kitty_mod": "Ctrl+Shift", "cmd": "Cmd", "plus": "+", "minus": "-",
             "equal": "=", "underscore": "_", "kp_add": "Num+", "kp_subtract": "Num-",
             "kp_0": "Num0", "page_up": "PgUp", "page_down": "PgDn"}
    return "+".join(names.get(p, p.capitalize() if len(p) > 1 else p.upper())
                    for p in combo.split("+"))


def tmux_shortcuts():
    """tmux.conf `bind [-T table] <key> <command>`, prefix first."""
    path = CONFIG / "tmux" / "tmux.conf"
    if not path.is_file():
        return []
    rows = []
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line.startswith("bind "):
            continue
        rest = line[5:].strip()
        table = ""
        if rest.startswith("-T "):
            parts = rest.split(None, 2)
            table, rest = parts[1], parts[2] if len(parts) > 2 else ""
        parts = rest.split(None, 1)
        if len(parts) != 2:
            continue
        key, cmd = parts
        prefix = "C-a " if not table else f"[{table}] "
        rows.append({"keys": prefix + key, "desc": cmd.strip()})
    return rows


def zsh_shortcuts():
    """bindkey lines from .zshrc, translated from escape sequences."""
    path = HOME / ".zshrc"
    if not path.is_file():
        return []
    seqs = {
        "^[[H": "Home", "^[[F": "End", "^[[3~": "Delete",
        "^[[1;5D": "Ctrl+Left", "^[[1;5C": "Ctrl+Right",
        "^H": "Ctrl+Backspace", "^[[3;5~": "Ctrl+Delete",
        "^[[1;3D": "Alt+Left", "^[[1;3C": "Alt+Right",
        "^[[A": "Up", "^[[B": "Down", "^[OA": "Up", "^[OB": "Down",
        "^[[5~": "PgUp", "^[[6~": "PgDn", "^[^M": "Alt+Enter",
    }
    rows, seen = [], set()
    for line in path.read_text(errors="replace").splitlines():
        m = re.match(r"\s*bindkey '([^']+)' ([\w-]+)", line.strip())
        if not m:
            continue
        combo = seqs.get(m.group(1), m.group(1))
        widget = m.group(2).replace("-", " ")
        if (combo, widget) in seen:
            continue
        seen.add((combo, widget))
        rows.append({"keys": combo, "desc": widget})
    return rows


def utilities():
    """Whatever `tools` reports, which is whatever the repo actually installs."""
    try:
        out = subprocess.run([str(HOME / '.local/bin/tools')], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    rows = []
    for line in out.stdout.splitlines():
        parts = line.split(None, 1)
        if not parts:
            continue
        name = parts[0]
        rows.append({
            "keys": name,
            "desc": parts[1].strip() if len(parts) > 1 else "",
            # Legacy launch metadata for older consumers; the current guide only
            # copies keys/commands and never runs this field.
            "exec": None if name in NO_CLICK else name,
        })
    return rows


