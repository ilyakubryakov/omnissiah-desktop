#!/usr/bin/env python3
"""Collect every shortcut and utility on this machine into one JSON file.

Read by the Quickshell cheatsheet (Meta+Shift+H). Generated rather than typed:
a hand-written cheatsheet is wrong within a week, and the machine already knows
its own bindings. Anything that cannot be read from a config is marked
curated=true so it is obvious which rows need a human when they go stale.

Sections are ordered as they should be read, not as they are collected.
"""

import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

HOME = Path.home()
OUT = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "cheatsheet.json"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))

MODIFIER = re.compile(r"\b(Meta|Ctrl|Alt|Shift)\b")
# Printed on the keyboard already; a modifier on top does not make them worth
# a row on a sheet meant for the things that get forgotten.
HARDWARE_KEY = re.compile(r"Volume|Brightness|Media|Microphone|Power|Sleep|Hibernate|Keyboard Light")


def kde_shortcuts():
    """Parse kglobalshortcutsrc: `Action=active,default,Friendly Name`.

    Only bindings carrying a modifier are kept. The rest are media and
    brightness keys, which are printed on the keyboard already and would bury
    the entries worth remembering.
    """
    path = CONFIG / "kglobalshortcutsrc"
    if not path.is_file():
        return []

    rows, group, friendly = [], "", {}
    pending = []
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("["):
            # A component ends here; flush what it collected under its name.
            rows.extend(pending)
            pending = []
            group = line.strip("[]").replace("][", " / ")
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)

        if key == "_k_friendly_name":
            friendly[group] = value
            for row in pending:
                row["group"] = value
            continue

        combo = value.split(",")[0].strip()
        # A tab separates alternative bindings; the first is the one to learn.
        combo = combo.split("\\t")[0].strip()
        if not combo or combo == "none" or not MODIFIER.search(combo):
            continue
        if HARDWARE_KEY.search(combo):
            continue

        label = value.split(",")[2].strip() if value.count(",") >= 2 else key
        if key == "_launch":
            # A command shortcut: the .desktop name is the only description.
            label = desktop_name(group.split("/")[-1].strip()) or key
        if not label or label == "none":
            label = key
        pending.append({"keys": combo, "desc": label, "group": friendly.get(group, group)})

    rows.extend(pending)

    # Two entries can share a combo across components; keep the first.
    seen, out = set(), []
    for r in sorted(rows, key=lambda r: (r["group"], r["keys"])):
        if r["keys"] in seen:
            continue
        seen.add(r["keys"])
        out.append(r)
    return out


