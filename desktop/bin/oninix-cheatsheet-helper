def hypr_rows(binds):
    groups = {}
    for b in binds:
        desc = (b.get('description') or '').strip()
        if not desc or b.get('release'):
            continue
        identity = (desc, b.get('modmask', 0), b.get('submap', ''))
        groups.setdefault(identity, []).append(str(b.get('key') or ('code:' + str(b.get('keycode', '')))))
    rows = []
    for (desc, mask, submap), keys in groups.items():
        mods = [name for bit, name in HYPR_MODS if mask & bit]
        keys = list(dict.fromkeys(keys))
        lowered = {k.lower() for k in keys}
        if lowered == {'left', 'right', 'up', 'down'}:
            key = '← ↑ ↓ →'
        elif lowered == set('0123456789'):
            key = '1…0'
        else:
            key = ' / '.join(HYPR_KEYS.get(k.lower(), k.capitalize() if len(k) > 1 else k.upper()) for k in keys)
        group, title, aliases = HYPR_LABELS.get(desc, ('Launch & tools' if 'focus or start' in desc or desc in {'Slack','Telegram','Thunderbird','Obsidian','Claude','ChatGPT / Codex'} else 'Other shortcuts', desc, ''))
        rows.append({'keys': '+'.join(mods + [key]), 'desc': title, 'group': group,
                     'action': desc, 'keywords': desc + ' ' + aliases,
                     'detail': 'Submap: ' + submap if submap else ''})
    return rows

def hyprland_shortcuts():
    try:
        signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')
        if not signature:
            display = os.environ.get('WAYLAND_DISPLAY')
            if not display:
                return []
            instances = subprocess.run(['hyprctl', 'instances', '-j'], capture_output=True, text=True, timeout=3)
            matches = [i['instance'] for i in json.loads(instances.stdout) if i.get('wl_socket') == display]
            if len(matches) != 1:
                return []
            signature = matches[0]
        out = subprocess.run(["hyprctl", '-i', signature, "binds", "-j"], capture_output=True, text=True, timeout=5)
        binds = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return []
    return hypr_rows(binds) if out.returncode == 0 and isinstance(binds, list) else []

def desktop_name(filename):
    for base in (HOME / ".local/share/applications", Path("/usr/share/applications")):
        p = base / filename
        if p.is_file():
            for line in p.read_text(errors="replace").splitlines():
                if line.startswith("Name="):
                    return line[5:].strip()
    return None

def kitty_shortcuts():
    path = CONFIG / "kitty" / "kitty.conf"
    rows = []
    for source in ([path] + [Path(l.split(None, 1)[1].strip()).expanduser()
                             for l in (path.read_text(errors="replace").splitlines()
                                       if path.is_file() else [])
                             if l.startswith("include ")]):
        if not source.is_file():
            continue
        for line in source.read_text(errors="replace").splitlines():
            if not line.startswith("map "):
                continue
            parts = line[4:].split(None, 1)
            if len(parts) == 2:
                rows.append({"keys": pretty_keys(parts[0]), "desc": short_action(parts[1])})
    return rows

def short_action(action):
    action = action.strip()
    if len(action) <= 40:
        return action
    words = action.split()
    head = " ".join(words[:2])
    if "search.py" in action:
        return "search scrollback"
    return head + " ..."

def pretty_keys(combo):
    names = {"kitty_mod": "Ctrl+Shift", "cmd": "Cmd", "plus": "+", "minus": "-",
             "equal": "=", "underscore": "_", "kp_add": "Num+", "kp_subtract": "Num-",
             "kp_0": "Num0", "page_up": "PgUp", "page_down": "PgDn"}
    return "+".join(names.get(p, p.capitalize() if len(p) > 1 else p.upper())
                    for p in combo.split("+"))

def tmux_shortcuts():
    path = CONFIG / "tmux" / "tmux.conf"
    if not path.is_file():
        return []
    rows = []
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line.startswith("bind "):
            continue
        rest = line[5:].strip()
        table = ""
        if rest.startswith("-T "):
            parts = rest.split(None, 2)
            table, rest = parts[1], parts[2] if len(parts) > 2 else ""
        parts = rest.split(None, 1)
        if len(parts) != 2:
            continue
        key, cmd = parts
        prefix = "C-a " if not table else f"[{table}] "
        rows.append({"keys": prefix + key, "desc": cmd.strip()})
    return rows

def zsh_shortcuts():
    path = HOME / ".zshrc"
    if not path.is_file():
        return []
    seqs = {
        "^[[H": "Home", "^[[F": "End", "^[[3~": "Delete",
        "^[[1;5D": "Ctrl+Left", "^[[1;5C": "Ctrl+Right",
        "^H": "Ctrl+Backspace", "^[[3;5~": "Ctrl+Delete",
        "^[[1;3D": "Alt+Left", "^[[1;3C": "Alt+Right",
        "^[[A": "Up", "^[[B": "Down", "^[OA": "Up", "^[OB": "Down",
        "^[[5~": "PgUp", "^[[6~": "PgDn", "^[^M": "Alt+Enter",
    }
    rows, seen = [], set()
    for line in path.read_text(errors="replace").splitlines():
        m = re.match(r"\s*bindkey '([^']+)' ([\w-]+)", line.strip())
        if not m:
            continue
        combo = seqs.get(m.group(1), m.group(1))
        widget = m.group(2).replace("-", " ")
        if (combo, widget) in seen:
            continue
        seen.add((combo, widget))
        rows.append({"keys": combo, "desc": widget})
    return rows

ICONS = {
    "Home": 0xF02DC, "KDE": 0xF0379, "Hyprland": 0xF0379, "kitty": 0xF018D,
    "tmux": 0xF0564, "zsh": 0xF1183,
}

def home_section(sections):
    hypr = next((s['rows'] for s in sections if s['name'] == 'Hyprland'), [])
    if hypr:
        actions = ['launcher: apps, projects, files', 'launchpad: apps in folders',
                   'terminal', 'control center', 'notebook: notes, calculator and timers',
                   'clipboard with previews', 'switch between all application windows',
                   'minimize window to the panel', 'show desktop / bring windows back',
                   'maximize', 'float / tile window', 'go to workspace (1..0)',
                   'capture: area / screen / video (bar menu), to clipboard', 'lock']
        return [row for action in actions for row in hypr if row['action'] == action]
    return []

def guides(rows):
    def key(action):
        return next((r['keys'] for r in rows if r['action'] == action), '')
    topics = [
        ('Panels and popovers', 'Hover over the clock, sound, weather or resources to preview a card. Click to pin it. Click another applet to switch cards; Esc or a click outside closes it.', 'hover popup calendar weather погода звук календарь', ''),
        ('Make the panels your own', 'Control Station > Panels & windows: drag groups between bars, reorder or hide them. Main and secondary screens have separate layouts. Right-click an empty area of the panel to open the editor.', 'panel editor панели порядок', 'control center'),
        ('Three ways to float', 'One window: ' + key('float / tile window') + '. This workspace: ' + key('float / tile the whole workspace') + '. For the whole desktop, use Tiling / Floating in the center of the bottom bar. Global mode remembers which windows it changed.', 'floating тайлинг плавающий рабочий стол', 'float / tile window'),
        ('Maximize or go fullscreen', 'Maximize keeps the panels visible; Fullscreen uses the entire display. Tab groups share one window area, while ' + key('switch between all application windows') + ' switches windows across workspaces.', 'maximize fullscreen развернуть полный экран вкладки', 'maximize'),
        ('Bring a minimized window back', 'Click its app icon on the panel. Hover to preview minimized windows; right-click for a list. Show desktop temporarily hides your windows and restores them when used again.', 'minimize restore свернуть вернуть', 'show desktop / bring windows back'),
        ('Capture a thought', 'The side notebook saves Markdown in your selected Obsidian vault. It also has a calculator, reminders and timers. Pin it to keep writing while working in another window.', 'notes obsidian calculator timer блокнот заметки калькулятор таймер', 'notebook: notes, calculator and timers'),
        ('Take a screenshot or record', 'Choose a region, screen or video in the panel camera menu. Capture follows that mode; Capture and save writes to ~/Pictures/Screenshots. Press the shortcut again to stop a recording.', 'capture record screenshot снимок видео запись', 'capture: area / screen / video (bar menu), to clipboard'),
        ('Before a call, game or recording', 'Control Station > Work modes: Work, Call, Game and Recording set DND and your selected audio devices. Recording enables Music low latency; Game turns Night light off. Normal restores previous settings while respecting manual changes.', 'work call game music normal режим звонок игра запись', 'control center'),
        ('Keep a look you like', 'Themes & wallpapers > Saved looks stores your palette, schedule, icons and panel styling. Undo reverts the last change. Wallpapers are selected separately and can follow the light or dark theme.', 'theme wallpaper daily undo look обои тема оформление', 'appearance: palettes and wallpapers'),
        ('Notifications without the noise', 'Notification Center offers Clear all and DND. Choose Important, Normal, Quiet or Hidden for an app or an individual title. Quiet keeps messages in history without showing a popup.', 'notification dnd уведомления история тихий', 'notification history'),
    ]
    return [{'desc': title, 'detail': body, 'keys': key(action), 'keywords': keywords,
             'kind': 'guide'} for title, body, keywords, action in topics]

def main():
    sections = [
        {"name": "kitty", "hint": "from kitty.conf", "rows": kitty_shortcuts()},
        {"name": "tmux", "hint": "from tmux.conf", "rows": tmux_shortcuts()},
        {"name": "zsh", "hint": "from .zshrc", "rows": zsh_shortcuts()},
        {"name": "Hyprland", "hint": "described binds, from hyprctl binds",
         "rows": hyprland_shortcuts()},
        {"name": "KDE", "hint": "global, from kglobalshortcutsrc",
         "rows": kde_shortcuts()},
    ]
    sections = [s for s in sections if s["rows"]]
    home = {"name": "Home", "hint": "Frequent actions from this session", "rows": home_section(sections)}
    hypr = next((s['rows'] for s in sections if s['name'] == 'Hyprland'), [])
    if hypr:
        categories = list(dict.fromkeys(r['group'] for r in hypr))
        sections = [home, {'name': 'Guide', 'hint': 'Using your desktop', 'rows': guides(hypr)}] + [
            {'name': group, 'hint': 'From the running Hyprland session', 'rows': [r for r in hypr if r['group'] == group]}
            for group in categories] + [s for s in sections if s['name'] != 'Hyprland']
    else:
        sections.insert(0, home)
    labels = {'Home': 'Essentials', 'Guide': 'How it works', 'kitty': 'Terminal · kitty'}
    for sec in sections:
        sec['label'] = labels.get(sec['name'], sec['name'])
        sec["icon"] = ICONS.get(sec["name"], {'Guide': 0xF00BA, 'Launch & tools': 0xF04DE, 'Windows': 0xF05AF,
                            'Workspaces & tabs': 0xF056D, 'Capture & recording': 0xF0100, 'Session & displays': 0xF033E}.get(sec['name'], 0xF04CE))

    out = {
        "ts": int(__import__("time").time()),
        "sections": sections,
        "warning": 'Could not read Hyprland shortcuts. Showing the available application settings only.' if (os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') or os.environ.get('WAYLAND_DISPLAY')) and not hypr else '',
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.cheatsheet-', dir=OUT.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(json.dumps(out, ensure_ascii=False, indent=1))
        os.replace(tmp, OUT)
    finally:
        Path(tmp).unlink(missing_ok=True)
    total = sum(len(s["rows"]) for s in out["sections"])
    print(f"{OUT}: {len(out['sections'])} sections, {total} rows")

if __name__ == "__main__":
    main()
