def home_section(sections):
    hypr = next((s['rows'] for s in sections if s['name'] == 'Hyprland'), [])
    if hypr:
        actions = ['launcher: apps, projects, files', 'launchpad: apps in folders',
                   'terminal', 'control center', 'notebook: notes, calculator and timers',
                   'clipboard with previews', 'switch between all application windows',
                   'minimize window to the panel', 'show desktop / bring windows back',
                   'maximize', 'float / tile window', 'go to workspace (1..0)',
                   'capture: area / screen / video (bar menu), to clipboard', 'lock']
        return [row for action in actions for row in hypr if row['action'] == action]
    index, present = {}, {sec["name"] for sec in sections}
    for sec in sections:
        for row in sec["rows"]:
            index[(sec["name"], row["keys"])] = row

    rows, missing = [], []
    for group, section, keys in HOME_PICKS:
        if section not in present:
            # The other desktop's picks (KDE vs Hyprland): not rot, just not here.
            continue
        row = index.get((section, keys))
        if row is None:
            missing.append(f"{section}:{keys}")
            continue
        rows.append(dict(row, group=group))
    if missing:
        print("home picks that no longer resolve: " + ", ".join(missing))
    return rows


