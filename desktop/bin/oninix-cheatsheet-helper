        ('Maximize or go fullscreen', 'Maximize keeps the panels visible; Fullscreen uses the entire display. Tab groups share one window area, while ' + key('switch between all application windows') + ' switches windows across workspaces.', 'maximize fullscreen развернуть полный экран вкладки', 'maximize'),
        ('Bring a minimized window back', 'Click its app icon on the panel. Hover to preview minimized windows; right-click for a list. Show desktop temporarily hides your windows and restores them when used again.', 'minimize restore свернуть вернуть', 'show desktop / bring windows back'),
        ('Capture a thought', 'The side notebook saves Markdown in your selected Obsidian vault. It also has a calculator, reminders and timers. Pin it to keep writing while working in another window.', 'notes obsidian calculator timer блокнот заметки калькулятор таймер', 'notebook: notes, calculator and timers'),
        ('Take a screenshot or record', 'Choose a region, screen or video in the panel camera menu. Capture follows that mode; Capture and save writes to Nextcloud/Img/Screenshots. Press the shortcut again to stop a recording.', 'capture record screenshot снимок видео запись', 'capture: area / screen / video (bar menu), to clipboard'),
        ('Before a call, game or recording', 'Control Center > Work modes: Work, Call, Game and Recording set DND and your selected audio devices. Recording enables Music low latency; Game turns Night light off. Normal restores previous settings while respecting manual changes.', 'work call game music normal режим звонок игра запись', 'control center'),
        ('Keep a look you like', 'Themes & wallpapers > Saved looks stores your palette, schedule, icons and panel styling. Undo reverts the last change. Wallpapers are selected separately and can follow the light or dark theme.', 'theme wallpaper daily undo look обои тема оформление', 'appearance: palettes and wallpapers'),
        ('Notifications without the noise', 'Notification Center offers Clear all and DND. Choose Important, Normal, Quiet or Hidden for an app or an individual title. Quiet keeps messages in history without showing a popup.', 'notification dnd уведомления история тихий', 'notification history'),
    ]
    return [{'desc': title, 'detail': body, 'keys': key(action), 'keywords': keywords,
             'kind': 'guide'} for title, body, keywords, action in topics]


def main():
    # Order is priority, not collection order: the panel fills its columns in
    # this sequence, so whatever matters most is read without scrolling. The
    # terminals come straight after KDE because they are what gets forgotten
    # most often.
    sections = [
        {"name": "kitty", "hint": "from kitty.conf", "rows": kitty_shortcuts()},
        {"name": "Utilities", "hint": "Installed commands; click to copy",
         "rows": utilities()},
        {"name": "tmux", "hint": "prefix C-a, from tmux.conf", "rows": tmux_shortcuts()},
        {"name": "zsh", "hint": "from .zshrc", "rows": zsh_shortcuts()},
        {"name": "Repo", "hint": "Maintenance commands; click to copy only",
         "rows": [{"keys": c, "desc": d, "exec": c} for c, d in REPO_COMMANDS]},
        {"name": "Neovim", "hint": "LazyVim, curated", "curated": True,
         "rows": [{"keys": k, "desc": d} for k, d in NVIM]},
        {"name": "Hyprland", "hint": "described binds, from hyprctl binds",
         "rows": hyprland_shortcuts()},
        {"name": "KDE", "hint": "global, from kglobalshortcutsrc",
         "rows": kde_shortcuts()},
    ]
    sections = [s for s in sections if s["rows"]]
    home = {"name": "Home", "hint": "Frequent actions from this session", "rows": home_section(sections)}
    hypr = next((s['rows'] for s in sections if s['name'] == 'Hyprland'), [])
    if hypr:
        categories = list(dict.fromkeys(r['group'] for r in hypr))
        sections = [home, {'name': 'Guide', 'hint': 'Using your desktop', 'rows': guides(hypr)}] + [
            {'name': group, 'hint': 'From the running Hyprland session', 'rows': [r for r in hypr if r['group'] == group]}
            for group in categories] + [s for s in sections if s['name'] != 'Hyprland']
    else:
        sections.insert(0, home)
    labels = {'Home': 'Essentials', 'Guide': 'How it works', 'kitty': 'Terminal · kitty',
              'Utilities': 'Our tools', 'Repo': 'Configuration', 'Neovim': 'Editor · Neovim'}
    for sec in sections:
        sec['label'] = labels.get(sec['name'], sec['name'])
        sec["icon"] = ICONS.get(sec["name"], {'Guide': 0xF00BA, 'Launch & tools': 0xF04DE, 'Windows': 0xF05AF,
                            'Workspaces & tabs': 0xF056D, 'Capture & recording': 0xF0100, 'Session & displays': 0xF033E}.get(sec['name'], 0xF04CE))

    out = {
        "ts": int(__import__("time").time()),
        "repo": str(REPO),
        "sections": sections,
        "warning": 'Could not read Hyprland shortcuts. Showing the available application settings only.' if (os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') or os.environ.get('WAYLAND_DISPLAY')) and not hypr else '',
    }
    OUT.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.cheatsheet-', dir=OUT.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(json.dumps(out, ensure_ascii=False, indent=1))
        os.replace(tmp, OUT)
    finally:
        Path(tmp).unlink(missing_ok=True)
    total = sum(len(s["rows"]) for s in out["sections"])
    print(f"{OUT}: {len(out['sections'])} sections, {total} rows")


if __name__ == "__main__":
    main()
