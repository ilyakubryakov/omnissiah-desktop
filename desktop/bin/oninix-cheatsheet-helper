#!/usr/bin/env python3

import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

HOME = Path.home()
OUT = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "cheatsheet.json"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))

MODIFIER = re.compile(r"\b(Meta|Ctrl|Alt|Shift)\b")
HARDWARE_KEY = re.compile(r"Volume|Brightness|Media|Microphone|Power|Sleep|Hibernate|Keyboard Light")

def kde_shortcuts():
    path = CONFIG / "kglobalshortcutsrc"
    if not path.is_file():
        return []

    rows, group, friendly = [], "", {}
    pending = []
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("["):
            rows.extend(pending)
            pending = []
            group = line.strip("[]").replace("][", " / ")
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)

        if key == "_k_friendly_name":
            friendly[group] = value
            for row in pending:
                row["group"] = value
            continue

        combo = value.split(",")[0].strip()
        combo = combo.split("\\t")[0].strip()
        if not combo or combo == "none" or not MODIFIER.search(combo):
            continue
        if HARDWARE_KEY.search(combo):
            continue

        label = value.split(",")[2].strip() if value.count(",") >= 2 else key
        if key == "_launch":
            label = desktop_name(group.split("/")[-1].strip()) or key
        if not label or label == "none":
            label = key
        pending.append({"keys": combo, "desc": label, "group": friendly.get(group, group)})

    rows.extend(pending)

    seen, out = set(), []
    for r in sorted(rows, key=lambda r: (r["group"], r["keys"])):
        if r["keys"] in seen:
            continue
        seen.add(r["keys"])
        out.append(r)
    return out

