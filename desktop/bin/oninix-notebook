#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
import oninix_notebook as notebook

os.umask(0o077)
if '--watch' in sys.argv:
    while True:
        try:
            notebook.tick()
        except Exception:
            print('Notebook reminder delivery failed; retrying.', file=sys.stderr, flush=True)
            time.sleep(10)
        time.sleep(1)
elif '--tick' in sys.argv:
    notebook.tick()
else:
    for line in sys.stdin:
        request = {}
        try:
            if len(line.encode()) > 600 * 1024:
                raise ValueError('Request too large')
            request = json.loads(line)
            result = dict(ok=True, data=notebook.handle(request))
        except notebook.NotebookError as exc:
            result = dict(ok=False, code=exc.code, message=str(exc))
        except Exception:
            result = dict(ok=False, code='io', message='The notebook could not complete this action. Your draft was kept; check the vault folder and try again.')
        result['requestId'] = request.get('requestId') if isinstance(request, dict) else None
        print(json.dumps(result, ensure_ascii=False), flush=True)
