#!/usr/bin/env python3
import concurrent.futures
import datetime as dt
import fcntl
import json
import math
import os
from pathlib import Path
import selectors
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request
import urllib.error
import urllib.parse
import re

CACHE = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'oninix-briefing'
CLUSTERS = []

def read(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}

def cached(key, ttl, fetch):
    CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = CACHE / (key + '.json')
    with (CACHE / (key + '.lock')).open('a') as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = read(path)
        now = time.time()
        if 0 <= now - old.get('checkedAt', 0) < ttl:
            return old
        try:
            data = {**fetch(), 'updatedAt': now, 'stale': False, 'error': ''}
        except Exception as error:
            message = str(error) if isinstance(error, SummaryError) else 'Update unavailable'
            data = {**old, 'stale': True, 'error': message}
        data['checkedAt'] = now
        fd, tmp = tempfile.mkstemp(dir=CACHE, prefix=key + '.')
        try:
            with os.fdopen(fd, 'w') as out:
                json.dump(data, out, allow_nan=False)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        return data

class SummaryError(Exception):
    pass

def number(value):
    return type(value) in (int, float) and math.isfinite(value)

def quota(key, label, used, minutes, reset):
    if not number(used) or used < 0:
        return None
    if isinstance(reset, str):
        try:
            reset = dt.datetime.fromisoformat(reset.replace('Z', '+00:00')).timestamp()
        except ValueError:
            reset = None
    return {'id': key, 'label': label, 'usedPercent': used,
            'windowMinutes': minutes if number(minutes) and minutes > 0 else None,
            'resetsAt': reset if number(reset) and reset > 0 else None}

def codex_response():
    try:
        proc = subprocess.Popen(['codex', 'app-server', '--listen', 'stdio://'],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        raise SummaryError('Codex CLI is not installed') from None
    def send(message):
        proc.stdin.write((json.dumps(message) + '\n').encode())
        proc.stdin.flush()
    try:
        send({'id': 1, 'method': 'initialize', 'params': {
            'clientInfo': {'name': 'station_panel', 'title': 'Station Panel', 'version': '1.0'}}})
        deadline, pending, total = time.monotonic() + 20, b'', 0
        with selectors.DefaultSelector() as events:
            events.register(proc.stdout, selectors.EVENT_READ)
            while time.monotonic() < deadline:
                if not events.select(min(1, max(0, deadline - time.monotonic()))):
                    continue
                chunk = os.read(proc.stdout.fileno(), 65536)
                if not chunk:
                    break
                pending += chunk
                total += len(chunk)
                if total > 4 * 1024 * 1024:
                    break
                while b'\n' in pending:
                    line, pending = pending.split(b'\n', 1)
                    data = json.loads(line)
                    if data.get('id') == 1:
                        if 'error' in data:
                            raise SummaryError('Codex client could not initialize')
                        send({'method': 'initialized', 'params': {}})
                        send({'id': 2, 'method': 'account/rateLimits/read', 'params': {}})
                    elif data.get('id') == 2:
                        if 'error' in data:
                            message = str(data['error']).lower()
                            if any(s in message for s in ('auth', 'login', 'logged', '401', 'chatgpt')):
                                raise SummaryError('Check Codex sign-in: codex login')
                            raise SummaryError('Codex limits unavailable')
                        return data['result']
        raise SummaryError('Codex limits request timed out')
    finally:
        proc.stdin.close()
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
        proc.stdout.close()

def codex_usage():
    data = codex_response()
    buckets = data.get('rateLimitsByLimitId') or {'codex': data.get('rateLimits')}
    windows = []
    for key, bucket in sorted(buckets.items(), key=lambda pair: pair[0] != 'codex'):
        if not isinstance(bucket, dict):
            continue
        for slot in ('primary', 'secondary'):
            value = bucket.get(slot)
            if not isinstance(value, dict):
                continue
            row = quota(key + ':' + slot, bucket.get('limitName') or key,
                        value.get('usedPercent'), value.get('windowDurationMins'), value.get('resetsAt'))
            if row:
                windows.append(row)
    if not windows:
        raise SummaryError('No subscription limits returned by Codex')
    return {'windows': windows}

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None

def claude_usage():
    directory = Path(os.environ.get('CLAUDE_CONFIG_DIR', Path.home() / '.claude'))
    auth = read(directory / '.credentials.json').get('claudeAiOauth', {})
    token = auth.get('accessToken')
    if not token:
        raise SummaryError('Sign in to Claude Code on this machine')
    if number(auth.get('expiresAt')) and auth['expiresAt'] <= time.time() * 1000:
        raise SummaryError('Open Claude Code to refresh sign-in')
    request = urllib.request.Request('https://api.anthropic.com/api/oauth/usage', headers={
        'Authorization': 'Bearer ' + token, 'anthropic-beta': 'oauth-2025-04-20',
        'User-Agent': 'StationPanel/1.0'})
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=12) as response:
            data = json.loads(response.read(1024 * 1024))
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            raise SummaryError('Open Claude Code to refresh sign-in') from None
        if error.code == 429:
            raise SummaryError('Claude usage endpoint is busy; retrying later') from None
        raise SummaryError('Claude limits unavailable') from None
    windows = []
    for key, label, minutes in [('five_hour', 'All models', 300), ('seven_day', 'All models', 10080),
                                ('seven_day_sonnet', 'Sonnet', 10080), ('seven_day_opus', 'Opus', 10080),
                                ('seven_day_oauth_apps', 'OAuth apps', 10080)]:
        value = data.get(key)
        if isinstance(value, dict):
            row = quota(key, label, value.get('utilization'), minutes, value.get('resets_at'))
            if row:
                windows.append(row)
    if not windows:
        raise SummaryError('No subscription limits returned by Claude')
    return {'windows': windows}

def kube(config, context, resource, fields):
    template = '{range .items[*]}' + '{"\\t"}'.join('{' + f + '}' for f in fields) + '{"\\n"}{end}'
    cmd = ['kubectl', '--kubeconfig', str(config), '--context', context, '--request-timeout=8s',
           'get', resource, '--all-namespaces', '-o', 'jsonpath=' + template]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except subprocess.TimeoutExpired:
        raise SummaryError('API request timed out') from None
    if result.returncode:
        err = result.stderr.lower()
        if 'forbidden' in err:
            raise SummaryError('Read access denied')
        if any(s in err for s in ('unauthorized', 'credential', 'certificate', 'logged in')):
            raise SummaryError('Authentication needs attention')
        raise SummaryError('API unreachable')
    return [line.split('\t') for line in result.stdout.splitlines() if line]

def age(value):
    try:
        return max(0, time.time() - dt.datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp())
    except (ValueError, TypeError):
        return float('inf')

def cluster(filename, context):
    config = Path.home() / '.kube/configs' / filename
    if not config.is_file():
        raise SummaryError('Kubeconfig is not installed')
    nodes = kube(config, context, 'nodes', ['.metadata.name', '.spec.unschedulable', '.status.conditions'])
    pods = kube(config, context, 'pods', ['.metadata.namespace', '.metadata.name', '.metadata.creationTimestamp',
                                        '.metadata.deletionTimestamp', '.status.phase', '.status.reason',
                                        '.status.conditions', '.status.containerStatuses', '.status.initContainerStatuses',
                                        '.metadata.ownerReferences[*].kind'])
    ready, cordoned, node_issues, pod_issues = 0, 0, [], []
    for name, unschedulable, conditions in nodes:
        conditions = json.loads(conditions or '[]')
        ok = any(c['type'] == 'Ready' and c['status'] == 'True' for c in conditions)
        ready += ok
        cordoned += unschedulable == 'true'
        reasons = [c['type'] for c in conditions if c['type'].endswith('Pressure') and c['status'] == 'True']
        if not ok:
            reasons.insert(0, 'NotReady')
        if reasons:
            node_issues.append({'name': name, 'reason': ', '.join(reasons)})
    active, ready_pods, completed = 0, 0, 0
    for namespace, name, created, deleted, phase, reason, conditions, containers, init, owner in pods:
        if phase == 'Succeeded':
            completed += 1
            continue
        if phase == 'Failed' and 'Job' in owner.split() and age(created) > 86400:
            continue
        active += 1
        conditions = json.loads(conditions or '[]')
        statuses = json.loads(containers or '[]') + json.loads(init or '[]')
        ok = any(c['type'] == 'Ready' and c['status'] == 'True' for c in conditions)
        ready_pods += ok and not deleted
        waiting = [c.get('state', {}).get('waiting', {}).get('reason', '') for c in statuses]
        failures = [r for r in waiting if r and r not in ('ContainerCreating', 'PodInitializing')]
        problem = ''
        if deleted:
            if age(deleted) > 300:
                problem = 'Terminating >5m'
        elif phase == 'Failed':
            problem = reason or 'Failed'
        elif failures:
            problem = ', '.join(sorted(set(failures)))
        elif phase == 'Unknown' or (not ok and age(created) > 120):
            problem = phase if phase != 'Running' else 'NotReady'
        if problem:
            pod_issues.append({'name': namespace + '/' + name, 'reason': problem})
    if not nodes:
        raise SummaryError('No nodes returned')
    return {'nodes': len(nodes), 'readyNodes': ready, 'cordoned': cordoned, 'pods': active,
            'readyPods': ready_pods, 'completed': completed, 'nodeIssues': node_issues[:8],
            'podIssues': pod_issues[:8], 'issueCount': len(node_issues) + len(pod_issues)}

def opencode_usage():
    import sqlite3
    path = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))) / 'opencode/opencode.db'
    if not path.is_file():
        return {'windows': [], 'note': 'No local OpenCode usage yet'}
    with sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=2) as db:
        row = db.execute("""SELECT count(*),
            coalesce(sum(json_extract(data, '$.tokens.input')),0),
            coalesce(sum(json_extract(data, '$.tokens.output')),0),
            coalesce(sum(json_extract(data, '$.tokens.cache.read')),0)
            FROM message WHERE json_extract(data,'$.role')='assistant'""").fetchone()
    return {'windows': [], 'note': 'Local history · all time; account limits unavailable',
            'tokens': {'input': row[1], 'output': row[2], 'cacheRead': row[3]}, 'messages': row[0]}

def ollama_usage():
    try:
        with urllib.request.urlopen('http://127.0.0.1:11434/api/ps', timeout=2) as response:
            models = json.load(response).get('models', [])
        resident = sum(m.get('size_vram', 0) for m in models if number(m.get('size_vram', 0)))
        return {'windows': [], 'note': f'Local · {len(models)} loaded model(s) · {resident / 1073741824:.1f} GiB VRAM · no account quota'}
    except (OSError, ValueError):
        return {'windows': [], 'note': 'Local Ollama is unavailable; no account quota'}

def google_usage():
    return {'windows': [], 'note': 'Antigravity / Gemini · sign in in the client; account quota integration pending'}

def backup_rows():
    return {'backups': []}

def main():
    if sys.argv[1:] == ['ai']:
        def collect_ai(target):
            key, fetch = target
            return {**cached(key, 120, fetch), 'id': key}
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
            result = {'providers': list(pool.map(collect_ai, [('codex', codex_usage), ('claude', claude_usage), ('opencode', opencode_usage), ('ollama', ollama_usage), ('google', google_usage)]))}
    elif sys.argv[1:] == ['clusters']:
        def collect(target):
            key, label, filename, context = target
            return {**cached(key, 120, lambda: cluster(filename, context)), 'id': key, 'label': label}
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
            result = {'clusters': list(pool.map(collect, CLUSTERS))}
    elif sys.argv[1:] == ['backups']:
        result = backup_rows()
    else:
        raise SystemExit('Usage: oninix-briefing ai|clusters|backups')
    print(json.dumps(result, allow_nan=False))

if __name__ == '__main__':
    main()
