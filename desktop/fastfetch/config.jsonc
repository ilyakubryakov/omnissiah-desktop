{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/run/current-system/sw/share/oninix/fastfetch/mechanicus.ans",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "yellow",
      "output": "default"
    },
    "brightColor": false,
    "disableLinewrap": true,
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": [
        "num"
      ]
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "{#yellow}COGITATOR{#}"
    },
    {
      "type": "board",
      "key": "Board",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    "break",
    {
      "type": "custom",
      "format": "{#yellow}MACHINE SPIRIT{#}"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "Compositor",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "format": "{days}d {hours}h {minutes}m"
    },
    "break",
    {
      "type": "localip",
      "key": "Network",
      "showPrefixLen": true,
      "format": "{ipv4}"
    }
  ]
}
